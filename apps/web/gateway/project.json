{
  "name": "web-gateway",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/gateway/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "jaeger-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.railway/jaeger.yaml",
        "{workspaceRoot}/tools/deployment/jaeger-check.mjs",
        { "dependentTasksOutputFiles": "**/*", "transitive": true }
      ],
      "options": { "command": "node tools/deployment/jaeger-check.mjs" }
    },
    "deployment-check": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit --module esnext --moduleResolution bundler --allowImportingTsExtensions --target es2022 --types node --skipLibCheck .railway/railway.ts",
          "eslint .railway tools/deployment/*.mjs",
          "bash -n tools/deployment/container.sh",
          "node --test tools/deployment/affected.spec.mjs"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "{workspaceRoot}/.railway/**/*",
        "{workspaceRoot}/tools/deployment/**/*",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["typescript", "eslint", "railway"]
        },
        "{workspaceRoot}/apps/web/*/project.json",
        "{workspaceRoot}/libs/**/project.json"
      ]
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/web/gateway/package.json",
        "{workspaceRoot}/dist/apps/web/gateway/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/web/gateway/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/web/gateway/patches",
        "{workspaceRoot}/dist/apps/web/gateway/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/web/gateway/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "dependsOn": ["^build"],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "env": {
          "API_APP_PATH": "../../../dist/apps/web/api/app.js",
          "SITE_APP_PATH": "../../../dist/apps/web/site/server/entry.mjs"
        }
      }
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ]
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["@playwright/test"]
        },
        {
          "env": "CI"
        },
        "{workspaceRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/compose.yaml",
        "{workspaceRoot}/compose.test.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ]
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web/gateway",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/apps/web/gateway/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "command": "eslint ."
      }
    },
    "test-ci": {
      "executor": "nx:noop",
      "dependsOn": ["test"]
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "container-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "production",
        "^production",
        "webStyles",
        "{workspaceRoot}/libs/backend/shared/**/*",
        "{workspaceRoot}/libs/web/backend/shared/**/*",
        "{workspaceRoot}/libs/web/frontend/ui/**/*",
        "{workspaceRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/tools/deployment/**/*",
        "{workspaceRoot}/.railway/**/*"
      ],
      "options": {
        "command": "bash tools/deployment/container.sh"
      }
    }
  },
  "implicitDependencies": ["web-api", "web-site"]
}

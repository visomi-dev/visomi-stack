{
  "name": "web-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^production",
        {
          "fileset": "{projectRoot}/tsconfig.spec.json",
          "dependencies": true
        },
        {
          "fileset": "{projectRoot}/tsconfig.storybook.json",
          "dependencies": true
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        }
      ]
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/web/api/package.json",
        "{workspaceRoot}/dist/apps/web/api/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/web/api/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/web/api/patches",
        "{workspaceRoot}/dist/apps/web/api/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/web/api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "dependsOn": ["^build"],
      "readyWhen": {
        "signal": true
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web/api",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^production",
        "^{projectRoot}/tsconfig*.json",
        {
          "externalDependencies": ["@playwright/test"]
        },
        {
          "env": "CI"
        }
      ]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/apps/web/api/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "command": "eslint ."
      }
    },
    "test-ci": {
      "executor": "nx:noop",
      "dependsOn": ["test"]
    }
  }
}

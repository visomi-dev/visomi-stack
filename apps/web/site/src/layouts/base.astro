---
import themeScript from '../../../../../theme.base.js?url&no-inline';
import '../styles/global.css';

type Props = {
  locale: 'en' | 'es';
  title: string;
  description?: string;
};

const { locale, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title} · Visomi Stack</title>
    <meta property="og:site_name" content="Visomi Stack" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Visomi Stack`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src={themeScript}></script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-zinc-950 dark:bg-zinc-950 dark:text-zinc-50">
    <slot />
  </body>
</html>

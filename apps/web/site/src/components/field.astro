---
import type { HTMLAttributes } from 'astro/types';

import { field as styles } from '@visomi-stack/web-frontend-ui';

type Props = HTMLAttributes<'div'> & { compact?: boolean; invalid?: boolean; manualError?: string | null };

const { compact = false, invalid = false, manualError, class: className, ...attributes } = Astro.props;
---

<div
  {...attributes}
  data-control
  data-invalid={invalid ? '' : undefined}
  data-manual-invalid={manualError ? '' : undefined}
  class:list={[styles.classes({ compact }), className]}
>
  <slot />
</div>

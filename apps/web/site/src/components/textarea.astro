---
import type { HTMLAttributes } from 'astro/types';

import { textarea as styles, type ControlSize } from '@visomi-stack/web-frontend-ui';

type Props = Omit<HTMLAttributes<'textarea'>, 'value'> & { uiSize?: ControlSize };

const { uiSize = 'md', class: className, ...attributes } = Astro.props;
---

<textarea
  {...attributes}
  data-slot="control"
  class:list={[styles.classes({ size: uiSize }), className]}
><slot /></textarea>

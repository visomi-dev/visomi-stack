---
import type { Locale } from '../content/site-content';
import LocaleSwitcher from './locale-switcher.astro';
import ThemeSwitcher from './theme-switcher.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const isEnglish = locale === 'en';
const copy = isEnglish
  ? {
      title: 'Visomi Stack | Build faster on a production-ready foundation',
      eyebrow: 'VISOMI STACK / FULL-STACK TEMPLATE',
      headline: 'Ship product ideas without rebuilding the platform first.',
      body: 'A focused Nx monorepo for teams that need a serious web foundation: Angular, Astro, Node, PostgreSQL, Redis, passkeys, encrypted storage, E2E coverage, and Themis workflow automation.',
      primary: 'Start building',
      secondary: 'Explore the architecture',
      architecture: 'One repository. Clear runtime boundaries.',
      architectureBody:
        'Public marketing, authenticated product surfaces, API, background jobs, realtime delivery, and local workflow state are designed to work together without becoming one tangled application.',
      cards: [
        [
          'Passkey-first auth',
          'WebAuthn is the default path, with verified email and explicit password fallback when users need it.',
        ],
        [
          'Zero-knowledge data',
          'Product data is encrypted before sync. Cloud runtimes validate and transport opaque envelopes.',
        ],
        [
          'Themis-powered delivery',
          'Projects, work items, evidence, verification, and independent review stay local in .themis.',
        ],
      ],
      included: 'Included from day one',
      includedBody:
        'The stack gives every new product the same quality gates and operational shape from its first commit.',
      items: [
        'Angular SSR application',
        'Astro public website',
        'Express API and OpenAPI contracts',
        'BullMQ worker and Socket.IO realtime',
        'PostgreSQL, Drizzle, Redis, Docker',
        'Playwright auth and gateway coverage',
        'OpenCode agents, skills, commands, and tools',
      ],
      finalTitle: 'Your product starts here.',
      finalBody: 'Clone the foundation, define your domain, and let Themis keep the work visible and verifiable.',
      footer: 'Visomi Stack. A reusable foundation for serious products.',
    }
  : {
      title: 'Visomi Stack | Construye sobre una base lista para producción',
      eyebrow: 'VISOMI STACK / TEMPLATE FULL-STACK',
      headline: 'Lanza ideas de producto sin reconstruir primero toda la plataforma.',
      body: 'Un monorepo Nx enfocado para equipos que necesitan una base web seria: Angular, Astro, Node, PostgreSQL, Redis, passkeys, almacenamiento cifrado, cobertura E2E y automatización de workflow con Themis.',
      primary: 'Empezar a construir',
      secondary: 'Explorar la arquitectura',
      architecture: 'Un repositorio. Límites de runtime claros.',
      architectureBody:
        'Marketing público, producto autenticado, API, jobs, realtime y estado local de workflow están diseñados para trabajar juntos sin convertirse en una aplicación imposible de mantener.',
      cards: [
        [
          'Auth passkey-first',
          'WebAuthn es el camino principal, con email verificado y password como fallback explícito.',
        ],
        [
          'Datos zero-knowledge',
          'Los datos de producto se cifran antes de sincronizarse. El cloud transporta envelopes opacos.',
        ],
        [
          'Workflow potenciado por Themis',
          'Proyectos, work items, evidencias, verificación y revisión viven localmente en .themis.',
        ],
      ],
      included: 'Incluido desde el primer día',
      includedBody:
        'Cada nuevo producto recibe los mismos quality gates y la misma forma operativa desde su primer commit.',
      items: [
        'Aplicación Angular SSR',
        'Website público con Astro',
        'API Express y contratos OpenAPI',
        'Worker BullMQ y realtime Socket.IO',
        'PostgreSQL, Drizzle, Redis y Docker',
        'Cobertura Playwright de auth y gateway',
        'Agents, skills, commands y tools de OpenCode',
      ],
      finalTitle: 'Tu producto empieza aquí.',
      finalBody: 'Clona la base, define tu dominio y deja que Themis mantenga el trabajo visible y verificable.',
      footer: 'Visomi Stack. Una base reusable para productos serios.',
    };
---

<main class="min-h-screen bg-white text-slate-950 dark:bg-slate-950 dark:text-slate-50">
  <nav
    class="sticky top-0 z-50 border-b border-slate-950/10 bg-white/85 px-4 py-4 backdrop-blur-md md:px-12 dark:border-white/10 dark:bg-slate-950/85"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
      <a
        href={locale === 'en' ? '/en/' : '/es/'}
        class="font-mono text-sm font-bold tracking-[0.22em] text-slate-950 uppercase dark:text-slate-50"
        >visomi<span class="text-slate-500">/</span>stack</a
      >
      <div class="flex items-center gap-2 sm:gap-5">
        <LocaleSwitcher locale={locale} />
        <ThemeSwitcher />
        <a
          href={locale === 'en' ? '/app/en/' : '/app/es/'}
          class="rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 dark:bg-slate-50 dark:text-slate-950 dark:hover:bg-white"
          >{copy.primary}</a
        >
      </div>
    </div>
  </nav>

  <section
    class="mx-auto grid min-h-[78vh] max-w-7xl items-center gap-12 px-4 py-16 md:grid-cols-[1.15fr_0.85fr] md:px-12 md:py-24"
  >
    <div>
      <p class="mb-6 font-mono text-xs font-bold tracking-[0.2em] text-slate-500 uppercase dark:text-slate-400">
        {copy.eyebrow}
      </p>
      <h1
        class="font-heading max-w-4xl text-5xl leading-[0.98] font-extrabold tracking-[-0.055em] md:text-7xl lg:text-8xl"
      >
        {copy.headline}
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.body}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href={locale === 'en' ? '/app/en/' : '/app/es/'}
          class="rounded-md bg-slate-950 px-6 py-3 text-center font-semibold text-white hover:bg-slate-700 dark:bg-slate-50 dark:text-slate-950 dark:hover:bg-white"
          >{copy.primary}</a
        >
        <a
          href="#architecture"
          class="rounded-md border border-slate-950/15 px-6 py-3 text-center font-semibold text-slate-700 hover:bg-slate-100 dark:border-white/15 dark:text-slate-200 dark:hover:bg-slate-900"
          >{copy.secondary}</a
        >
      </div>
    </div>
    <div class="rounded-lg bg-slate-100 p-4 dark:bg-slate-900">
      <div
        class="rounded-md border border-slate-950/10 bg-white p-5 font-mono text-xs dark:border-white/10 dark:bg-slate-950"
      >
        <div class="mb-6 flex items-center justify-between text-slate-500">
          <span>runtime-map</span><span>ready</span>
        </div>
        <div class="grid gap-2">
          {
            [
              'site / Astro',
              'app / Angular SSR',
              'api / Express + OpenAPI',
              'worker / BullMQ',
              'realtime / Socket.IO',
              'vault / WebCrypto + IndexedDB',
              'workflow / .themis + OpenCode',
            ].map((item, index) => (
              <div class="flex items-center gap-3 rounded-md bg-slate-100 px-3 py-3 dark:bg-slate-900">
                <>
                  <span class="text-slate-400">0{index + 1}</span>
                  <span>{item}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    id="architecture"
    class="border-y border-slate-950/10 bg-slate-50 px-4 py-16 md:px-12 md:py-24 dark:border-white/10 dark:bg-slate-900/60"
  >
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-xs font-bold tracking-[0.2em] text-slate-500 uppercase dark:text-slate-400">
        01 / architecture
      </p>
      <h2 class="font-heading mt-4 max-w-3xl text-4xl font-extrabold tracking-tight md:text-6xl">
        {copy.architecture}
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.architectureBody}</p>
      <div class="mt-12 grid gap-4 md:grid-cols-3 md:gap-6">
        {
          copy.cards.map(([title, body]) => (
            <article class="rounded-lg bg-white p-6 dark:bg-slate-950">
              <>
                <h3 class="font-heading text-xl font-bold">{title}</h3>
                <p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">{body}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-12 px-4 py-16 md:grid-cols-[0.8fr_1.2fr] md:px-12 md:py-24">
    <div>
      <p class="font-mono text-xs font-bold tracking-[0.2em] text-slate-500 uppercase dark:text-slate-400">
        02 / foundation
      </p><h2 class="font-heading mt-4 text-4xl font-extrabold tracking-tight md:text-5xl">{copy.included}</h2><p
        class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300"
      >
        {copy.includedBody}
      </p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        copy.items.map((item, index) => (
          <li class="flex gap-4 border-b border-slate-950/10 py-4 text-sm font-semibold dark:border-white/10">
            <>
              <span class="font-mono text-slate-400">{String(index + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="border-t border-slate-950/10 bg-slate-950 px-4 py-20 text-center text-white md:px-12 md:py-28 dark:border-white/10"
  >
    <h2 class="font-heading text-4xl font-extrabold tracking-tight md:text-6xl">{copy.finalTitle}</h2><p
      class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-300"
    >
      {copy.finalBody}
    </p><a
      href={locale === 'en' ? '/app/en/' : '/app/es/'}
      class="mt-9 inline-flex rounded-md bg-white px-6 py-3 font-semibold text-slate-950 hover:bg-slate-200"
      >{copy.primary}</a
    >
  </section>
</main>

<footer class="border-t border-slate-950/10 bg-slate-50 px-4 py-8 md:px-12 dark:border-white/10 dark:bg-slate-900">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-3 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:text-slate-400"
  >
    <span>{copy.footer}</span><span>© 2026 Visomi</span>
  </div>
</footer>

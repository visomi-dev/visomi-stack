---
import type { HTMLAttributes } from 'astro/types';

import { divider as styles } from '@visomi-stack/web-frontend-ui';

type Props = HTMLAttributes<'hr'> & { soft?: boolean };

const { soft = false, class: className, ...attributes } = Astro.props;
---

<hr {...attributes} class:list={[styles.classes({ soft: soft }), className]} />

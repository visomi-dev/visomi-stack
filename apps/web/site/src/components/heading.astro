---
import type { HTMLAttributes } from 'astro/types';

import { heading as styles, type HeadingSize, type HeadingTone } from '@visomi-stack/web-frontend-ui';

type Props = HTMLAttributes<'h2'> & {
  'ui-size'?: HeadingSize;
  tone?: HeadingTone;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'span';
};

const { 'ui-size': uiSize = 'lg', tone = 'default', as: Tag = 'h2', class: className, ...attributes } = Astro.props;
---

<Tag {...attributes} class:list={[styles.classes({ size: uiSize, tone }), className]}>
  <slot />
</Tag>

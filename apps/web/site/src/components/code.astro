---
import type { HTMLAttributes } from 'astro/types';

import { code as styles } from '@visomi-stack/web-frontend-ui';

type Props = HTMLAttributes<'code'> & { block?: boolean };

const { block = false, class: className, ...attributes } = Astro.props;
---

<code {...attributes} class:list={[styles.classes({ block: block }), className]}>
  <slot />
</code>

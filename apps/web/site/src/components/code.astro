---
import type { HTMLAttributes } from 'astro/types';

import { code as styles, type CodeVariant } from '@visomi-stack/web-frontend-ui';

type Props = HTMLAttributes<'code'> & { block?: boolean; variant?: CodeVariant };

const { block = false, variant = 'default', class: className, ...attributes } = Astro.props;
---

<code {...attributes} class:list={[styles.classes({ block, variant }), className]}>
  <slot />
</code>

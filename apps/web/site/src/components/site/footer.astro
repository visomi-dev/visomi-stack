---
import Brand from './brand.astro';
import Icon from './icon.astro';
import { repositoryUrl, siteCopy, sitePath, type SiteLocale } from '../../content/site';
type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const copy = siteCopy[locale];
const linkClasses =
  'ui-focus-ring inline-flex min-h-11 items-center gap-2 rounded-lg text-sm text-zinc-600 hover:text-blue-700 dark:text-zinc-400 dark:hover:text-blue-400';
---

<footer class="border-t border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40">
  <div class="mx-auto max-w-7xl px-5 pt-14 pb-6 sm:px-8">
    <div class="grid gap-10 pb-12 md:grid-cols-[1.5fr_1fr_1fr] md:gap-16">
      <div>
        <Brand locale={locale} />
        <p class="mt-5 max-w-sm text-sm leading-7 text-zinc-600 dark:text-zinc-400">{copy.footerBody}</p>
      </div>
      <nav aria-label={copy.footerExplore}>
        <h2 class="mb-3 text-sm font-semibold">{copy.footerExplore}</h2>
        <ul>
          {(['architecture', 'ui', 'foundations'] as const).map((page) => (
            <li>
              <a href={sitePath(locale, page)} class={linkClasses}>
                {copy.nav[page]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label={copy.footerBuild}>
        <h2 class="mb-3 text-sm font-semibold">{copy.footerBuild}</h2>
        <ul>
          <li>
            <a href={sitePath(locale, 'docs')} class={linkClasses}>
              {copy.start}
            </a>
          </li>
          <li>
            <a href={repositoryUrl} class={linkClasses}>
              {copy.source}
              <Icon name="arrow-right" class="size-4" />
            </a>
          </li>
          <li>
            <a href={`${repositoryUrl}/tree/main/docs`} class={linkClasses}>
              {copy.repoDocs}
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-zinc-200 pt-5 text-xs leading-6 text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
      <p>© {new Date().getUTCFullYear()} Visomi Stack</p>
      <p>{copy.footer}</p>
      <a href="#top" class="ui-focus-ring inline-flex min-h-11 items-center rounded-lg">
        {copy.backTop}
      </a>
    </div>
  </div>
</footer>

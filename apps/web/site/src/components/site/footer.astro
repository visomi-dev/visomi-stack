---
import Container from '../container.astro';
import Text from '../text.astro';
import Heading from '../heading.astro';
import Brand from './brand.astro';
import Link from '../link.astro';
import Icon from './icon.astro';
import { repositoryUrl, siteCopy, sitePath, type SiteLocale } from '../../content/site';
type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const copy = siteCopy[locale];
---

<footer class="border-t border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40">
  <Container as="div" width="xl" gutter="compact" class="pt-14 pb-6">
    <div class="grid gap-10 pb-12 md:grid-cols-[1.5fr_1fr_1fr] md:gap-16">
      <div>
        <Brand locale={locale} />
        <Text ui-size="sm" tone="muted" leading="relaxed" class="mt-5 max-w-sm">
          {copy.footerBody}
        </Text>
      </div>
      <nav aria-label={copy.footerExplore}>
        <Heading as="h2" ui-size="label" class="mb-3">
          {copy.footerExplore}
        </Heading>
        <ul>
          {(['architecture', 'ui', 'foundations'] as const).map((page) => (
            <li>
              <Link
                href={sitePath(locale, page)}
                variant="muted"
                underline="none"
                class="inline-flex min-h-11 items-center gap-2 text-sm"
              >
                {copy.nav[page]}
              </Link>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label={copy.footerBuild}>
        <Heading as="h2" ui-size="label" class="mb-3">
          {copy.footerBuild}
        </Heading>
        <ul>
          <li>
            <Link
              href={sitePath(locale, 'docs')}
              variant="muted"
              underline="none"
              class="inline-flex min-h-11 items-center gap-2 text-sm"
            >
              {copy.start}
            </Link>
          </li>
          <li>
            <Link
              href={repositoryUrl}
              variant="muted"
              underline="none"
              class="inline-flex min-h-11 items-center gap-2 text-sm"
            >
              {copy.source}
              <Icon name="arrow-right" class="size-4" />
            </Link>
          </li>
          <li>
            <Link
              href={`${repositoryUrl}/tree/main/docs`}
              variant="muted"
              underline="none"
              class="inline-flex min-h-11 items-center gap-2 text-sm"
            >
              {copy.repoDocs}
            </Link>
          </li>
        </ul>
      </nav>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-zinc-200 pt-5 text-xs leading-6 text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
      <Text ui-size="inherit" tone="inherit">
        © {new Date().getUTCFullYear()} Visomi Stack
      </Text>
      <Text ui-size="inherit" tone="inherit">
        {copy.footer}
      </Text>
      <Link href="#top" variant="muted" underline="none" class="inline-flex min-h-11 items-center">
        {copy.backTop}
      </Link>
    </div>
  </Container>
</footer>

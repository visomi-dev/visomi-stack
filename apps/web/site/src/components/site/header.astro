---
import Brand from './brand.astro';
import Link from '../link.astro';
import Icon from './icon.astro';
import { siteCopy, sitePath, type SiteLocale, type SitePage } from '../../content/site';
type Props = { locale: SiteLocale; page: SitePage };
const { locale, page } = Astro.props;
const copy = siteCopy[locale];
const pages = ['home', 'architecture', 'docs', 'ui'] as const;
---

<header
  class="sticky top-0 z-50 border-b border-zinc-200 bg-white/95 dark:border-zinc-800 dark:bg-zinc-950/95"
  data-site-header
>
  <div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-2 px-5 sm:px-8">
    <Brand locale={locale} compact />
    <nav aria-label={copy.menu} class="hidden lg:flex lg:items-center lg:gap-1">
      {pages.map((destination) => (
        <Link
          href={sitePath(locale, destination)}
          variant="muted"
          underline="none"
          class="inline-flex min-h-11 items-center px-3 text-sm"
          aria-current={page === destination ? 'page' : undefined}
        >
          {copy.nav[destination]}
        </Link>
      ))}
    </nav>
    <div class="flex items-center gap-1.5 sm:gap-3">
      <nav aria-label={copy.language} class="flex gap-0.5 text-xs font-medium">
        {(['en', 'es'] as const).map((language) => (
          <Link
            href={sitePath(language, page)}
            hreflang={language}
            lang={language}
            aria-current={locale === language ? 'page' : undefined}
            variant="muted"
            underline="none"
            class="inline-flex min-h-11 min-w-11 items-center justify-center"
          >
            {language.toUpperCase()}
          </Link>
        ))}
      </nav>
      <label>
        <span class="sr-only">{copy.theme}</span>
        <select
          data-theme-select
          class="ui-focus-ring min-h-11 max-w-28 cursor-pointer rounded-lg border border-zinc-300 bg-transparent px-2 text-xs text-zinc-700 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-200"
        >
          <option value="system">{copy.system}</option>
          <option value="light">{copy.light}</option>
          <option value="dark">{copy.dark}</option>
        </select>
      </label>
      <details class="group relative lg:hidden" data-site-menu>
        <summary class="ui-focus-ring flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-zinc-300 hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-900 [&::-webkit-details-marker]:hidden">
          <span class="sr-only">{copy.menu}</span>
          <Icon name="menu" />
        </summary>
        <nav
          aria-label={copy.menu}
          class="absolute top-14 right-0 grid w-64 max-w-[calc(100vw-2.5rem)] gap-1 rounded-xl border border-zinc-200 bg-white p-3 shadow-xl shadow-zinc-950/10 dark:border-zinc-700 dark:bg-zinc-900"
        >
          {pages.map((destination) => (
            <Link
              href={sitePath(locale, destination)}
              variant="muted"
              underline="none"
              class="inline-flex min-h-11 items-center px-3 text-sm"
              aria-current={page === destination ? 'page' : undefined}
            >
              {copy.nav[destination]}
            </Link>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

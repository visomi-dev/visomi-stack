---
import { card, linkButton } from '@visomi-stack/web-frontend-ui';
import ThemeSwitcher from '../theme-switcher.astro';
import Container from '../container.astro';
import Text from '../text.astro';
import Brand from './brand.astro';
import Link from '../link.astro';
import LinkButton from '../link-button.astro';
import Icon from './icon.astro';
import { applicationPath, siteCopy, sitePath, type SiteLocale, type SitePage } from '../../content/site';
type Props = { locale: SiteLocale; page: SitePage };
const { locale, page } = Astro.props;
const copy = siteCopy[locale];
const pages = ['home', 'architecture', 'docs', 'ui'] as const;
const languages = [
  ['en', 'English'],
  ['es', 'Español'],
] as const;
---

<header
  class="sticky top-0 z-50 border-b border-zinc-200 bg-white/95 dark:border-zinc-800 dark:bg-zinc-950/95"
  data-site-header
>
  <Container as="div" width="xl" gutter="compact" class="flex min-h-20 items-center justify-between gap-2">
    <Brand locale={locale} compact />

    <nav aria-label={copy.menu} class="hidden lg:flex lg:items-center lg:gap-1">
      {pages.map((destination) => (
        <Link
          href={sitePath(locale, destination)}
          variant="muted"
          underline="none"
          class="inline-flex min-h-11 items-center px-3 text-sm"
          aria-current={page === destination ? 'page' : undefined}
        >
          {copy.nav[destination]}
        </Link>
      ))}
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-3">
      <div class="hidden lg:block">
        <LinkButton href={applicationPath(locale)} size="sm">
          {copy.openApp}
        </LinkButton>
      </div>

      <nav aria-label={copy.language} class="flex items-center gap-2">
        {languages.map(([language, label]) =>
          locale === language ? (
            <span lang={language} aria-current="true" class="inline-flex min-h-11 items-center text-sm font-medium">
              {label}
            </span>
          ) : (
            <Link
              href={sitePath(language, page)}
              hreflang={language}
              lang={language}
              variant="muted"
              underline="hover"
              class="inline-flex min-h-11 items-center text-sm"
            >
              {label}
            </Link>
          ),
        )}
      </nav>

      <ThemeSwitcher label={copy.themeToggle} />

      <details class="group relative lg:hidden" data-site-menu>
        <summary
          class:list={[
            linkButton.classes({ variant: 'secondary', size: 'icon' }),
            'cursor-pointer list-none [&::-webkit-details-marker]:hidden',
          ]}
        >
          <Text as="span" ui-size="inherit" tone="inherit" class="sr-only">
            {copy.menu}
          </Text>

          <Icon name="menu" />
        </summary>

        <nav
          aria-label={copy.menu}
          class:list={[
            card.classes({ padding: 'sm', layout: 'plain' }),
            'absolute top-14 right-0 grid w-64 max-w-[calc(100vw-2.5rem)] gap-1 shadow-xl shadow-zinc-950/10',
          ]}
        >
          {pages.map((destination) => (
            <Link
              href={sitePath(locale, destination)}
              variant="muted"
              underline="none"
              class="inline-flex min-h-11 items-center px-3 text-sm"
              aria-current={page === destination ? 'page' : undefined}
            >
              {copy.nav[destination]}
            </Link>
          ))}

          <LinkButton href={applicationPath(locale)} size="sm" class="mt-1">
            {copy.openApp}
          </LinkButton>
        </nav>
      </details>
    </div>
  </Container>
</header>

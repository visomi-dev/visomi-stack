---
import { siteCopy, type SiteLocale } from '../../content/site';
import Icon from './icon.astro';
import Badge from '../badge.astro';
type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const copy = siteCopy[locale].architecture;
---

<figure class="min-w-0 rounded-2xl border border-zinc-200 bg-zinc-50 p-5 sm:p-8 dark:border-zinc-700 dark:bg-zinc-900/60">
  <figcaption class="mb-7 flex flex-wrap items-center justify-between gap-3 font-mono text-xs text-zinc-600 dark:text-zinc-400">
    <span>{copy.diagramTitle}</span>
    <span>HTTP / SSR</span>
  </figcaption>
  <div class="rounded-xl border border-blue-300 bg-blue-50 px-5 py-5 dark:border-blue-800 dark:bg-blue-950/50">
    <div class="flex items-center gap-3">
      <Icon name="layers" class="size-6 text-blue-700 dark:text-blue-400" />
      <span class="font-heading text-lg font-semibold">Express gateway</span>
    </div>
    <p class="mt-3 max-w-md text-sm leading-6 text-zinc-600 dark:text-zinc-400">{copy.gatewayNote}</p>
  </div>
  <div class="mx-auto h-7 w-px bg-blue-300 dark:bg-blue-800" aria-hidden="true"></div>
  <div class="grid gap-3 sm:grid-cols-2">
    {copy.map.slice(0, 2).map(([name, technology, path]) => (
      <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-700 dark:bg-zinc-950">
        <p class="mb-1 text-sm text-zinc-600 dark:text-zinc-400">{name}</p>
        <p class="font-heading text-xl font-semibold">{technology}</p>
        <code class="mt-4 block font-mono text-xs text-blue-700 dark:text-blue-400">{path}</code>
      </div>
    ))}
  </div>
  <div class="mt-5 rounded-xl border border-dashed border-zinc-400 bg-white p-5 dark:border-zinc-600 dark:bg-zinc-950">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">{copy.standalone}</p>
        <p class="mt-1 font-heading text-xl font-semibold">Angular SSR</p>
      </div>
      <Badge>{copy.nextMount}</Badge>
    </div>
    <code class="mt-4 block font-mono text-xs text-blue-700 dark:text-blue-400">/app/en/ · /app/es/</code>
  </div>
</figure>

---
import { text } from '@visomi-stack/web-frontend-ui';
import Code from '../code.astro';
import Card from '../card.astro';
import Text from '../text.astro';
import Heading from '../heading.astro';
import { siteCopy, type SiteLocale } from '../../content/site';
import Icon from './icon.astro';
import Badge from '../badge.astro';
type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const copy = siteCopy[locale].architecture;
---

<Card as="figure" tone="subtle" padding="lg" layout="plain">
  <Text as="figcaption" ui-size="xs" tone="muted" mono class="mb-7 flex flex-wrap items-center justify-between gap-3">
    <span>{copy.diagramTitle}</span>
    <span>HTTP / SSR</span>
  </Text>
  <Card as="div" tone="accent" padding="md" layout="plain">
    <div class="flex items-center gap-3">
      <Icon name="layers" class="size-6 text-blue-700 dark:text-blue-400" />
      <Heading as="span" ui-size="sm" tone="inherit">
        Express gateway
      </Heading>
    </div>
    <Text ui-size="sm" tone="muted" class="mt-3 max-w-md">
      {copy.gatewayNote}
    </Text>
  </Card>
  <div class="mx-auto h-7 w-px bg-blue-300 dark:bg-blue-800" aria-hidden="true"></div>
  <div class="grid gap-3 sm:grid-cols-2">
    {copy.map.slice(0, 2).map(([name, technology, path]) => (
      <Card as="div" tone="default" padding="lg" layout="plain">
        <Text ui-size="sm" tone="muted" class="mb-1">
          {name}
        </Text>
        <Heading as="p" ui-size="md">
          {technology}
        </Heading>
        <Code variant="plain" class:list={[text.classes({ size: 'xs', tone: 'accent' }), 'mt-4 block']}>
          {path}
        </Code>
      </Card>
    ))}
  </div>
  <Card as="div" tone="default" padding="lg" layout="plain" class="mt-5 border-dashed">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <Text ui-size="sm" tone="muted">
          {copy.standalone}
        </Text>
        <Heading as="p" ui-size="md" class="mt-1">
          Angular SSR
        </Heading>
      </div>
      <Badge>{copy.nextMount}</Badge>
    </div>
    <Code variant="plain" class:list={[text.classes({ size: 'xs', tone: 'accent' }), 'mt-4 block']}>
      /app/en/ · /app/es/
    </Code>
  </Card>
</Card>

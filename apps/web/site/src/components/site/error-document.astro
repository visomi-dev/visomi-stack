---
import BaseLayout from '../../layouts/base.astro';
import Card from '../card.astro';
import Container from '../container.astro';
import Heading from '../heading.astro';
import LinkButton from '../link-button.astro';
import Text from '../text.astro';
import ThemeSwitcher from '../theme-switcher.astro';
import { httpErrors } from '../../content/http-errors';
import type { SiteLocale } from '../../content/site';

type Props = { locale: SiteLocale; status: string };

const { locale, status } = Astro.props;
const error = httpErrors[status];
const [title, description] = error[locale];
const home = `/${locale}/`;
const signIn = error.action === 'sign-in';
const retry = error.action === 'retry';
const labels = {
  en: { home: 'Go to home', retry: 'Try again', signIn: 'Sign in', theme: 'Dark mode' },
  es: { home: 'Ir al inicio', retry: 'Intentar de nuevo', signIn: 'Iniciar sesión', theme: 'Modo oscuro' },
}[locale];
---

<BaseLayout locale={locale} title={title} description={description} telemetry={false}>
  <meta name="robots" content="noindex" slot="head" />
  <header class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8">
    <a href={home} class="font-heading text-lg font-bold tracking-tight ui-focus-ring">
      VISOMI<span class="ml-1 text-blue-600">.</span>
    </a>
    <ThemeSwitcher label={labels.theme} />
  </header>
  <main class="grid min-h-[70dvh] place-items-center py-8">
    <Container width="sm" gutter="compact">
      <Card as="section" aria-labelledby="error-title" padding="lg">
        <Text tone="accent" ui-size="sm" mono>
          {status}
        </Text>
        <Heading as="h1" id="error-title">
          {title}
        </Heading>
        <Text tone="muted">{description}</Text>
        <div class="mt-2 flex flex-wrap gap-3">
          {retry || signIn ? (
            <>
              <LinkButton href={signIn ? `/app/${locale}/auth/sign-in` : ''}>
                {signIn ? labels.signIn : labels.retry}
              </LinkButton>
              <LinkButton href={home} variant="secondary">
                {labels.home}
              </LinkButton>
            </>
          ) : (
            <LinkButton href={home}>{labels.home}</LinkButton>
          )}
        </div>
      </Card>
    </Container>
  </main>
</BaseLayout>

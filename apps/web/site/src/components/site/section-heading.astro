---
import Text from '../text.astro';
import Heading from '../heading.astro';
type Props = { kicker: string; title: string; description?: string; id?: string };
const { kicker, title, description, id } = Astro.props;
---

<div class="max-w-2xl">
  <Text uiSize="xs" tone="accent" mono leading="relaxed" class="mb-5 tracking-widest">
    {kicker}
  </Text>
  <Heading as="h2" uiSize="section" id={id}>
    {title}
  </Heading>
  {description && (
    <Text uiSize="lead" tone="muted" class="mt-6 max-w-xl">
      {description}
    </Text>
  )}
</div>

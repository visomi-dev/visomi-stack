---
type Props = { kicker: string; title: string; description?: string; id?: string };
const { kicker, title, description, id } = Astro.props;
---

<div class="max-w-2xl">
  <p class="mb-5 font-mono text-xs leading-6 tracking-widest text-blue-700 dark:text-blue-400">{kicker}</p>
  <h2
    id={id}
    class="font-heading text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl"
  >
    {title}
  </h2>
  {description && (
    <p class="mt-6 max-w-xl text-base leading-7 text-pretty text-zinc-600 sm:text-lg dark:text-zinc-400">
      {description}
    </p>
  )}
</div>

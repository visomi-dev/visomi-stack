---
import type { HTMLAttributes } from 'astro/types';

import { badge as styles, type Tone } from '@visomi-stack/web-frontend-ui';

type Props = HTMLAttributes<'span'> & { tone?: Tone };

const { tone = 'neutral', class: className, ...attributes } = Astro.props;
---

<span {...attributes} class:list={[styles.classes({ tone: tone }), className]}>
  <slot />
</span>

---
import type { HTMLAttributes } from 'astro/types';

import { table as styles, type TableDensity } from '@visomi-stack/web-frontend-ui';

type Props = HTMLAttributes<'table'> & { density?: TableDensity; striped?: boolean };

const { density = 'comfortable', striped = false, class: className, ...attributes } = Astro.props;
---

<table {...attributes} class:list={[styles.classes({ density: density, striped: striped }), className]}>
  <slot />
</table>

---
import { uiDocs, type UiLocale } from '../../ui-docs';
import Card from '../card.astro';
import Container from '../container.astro';
import PageHeader from '../page-header.astro';
import Heading from '../heading.astro';
import Text from '../text.astro';
import Button from '../button.astro';
import Preview from './preview.astro';
type Props = { locale: UiLocale };
const { locale } = Astro.props;
const labels = uiDocs[locale];
---

<Preview
  id="container"
  locale={locale}
  angular={'<div appUI="container" width="sm">Content</div>'}
  astro={'<Container width="sm">Content</Container>'}
>
  <div class="rounded-lg border border-dashed border-zinc-300 py-5 dark:border-zinc-700">
    <Container width="sm">
      <Text ui-size="sm" tone="muted">
        {labels.containerNote}
      </Text>
    </Container>
  </div>
</Preview>
<Preview
  id="card"
  locale={locale}
  angular={'<article appUI tone="raised" padding="md">Content</article>'}
  astro={'<Card tone="raised" padding="md">Content</Card>'}
>
  <div class="grid gap-4 sm:grid-cols-2">
    <Card>
      <Heading as="h4" ui-size="sm">
        {labels.cardTitle}
      </Heading>
      <Text ui-size="sm" tone="muted">
        {labels.cardBody}
      </Text>
    </Card>
    <Card tone="raised">
      <Heading as="h4" ui-size="sm">
        {labels.cardRaised}
      </Heading>
      <Text ui-size="sm" tone="muted">
        {labels.cardBody}
      </Text>
    </Card>
  </div>
  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    {(['subtle', 'accent', 'inverse'] as const).map((tone) => (
      <Card tone={tone} padding="sm" layout="plain">
        <Text ui-size="sm" tone="inherit">
          {labels.cardBody}
        </Text>
      </Card>
    ))}
  </div>
  <Card tone="ghost" padding="sm" class="mt-4">
    <Text ui-size="sm" tone="muted">
      {labels.cardGhost}
    </Text>
  </Card>
</Preview>
<Preview
  id="page-header"
  locale={locale}
  angular={'<header appUI><h2>Workspace settings</h2><button appUI>Save</button></header>'}
  astro={'<PageHeader><Heading>Workspace settings</Heading><Button>Save</Button></PageHeader>'}
>
  <PageHeader>
    <div class="grid gap-2">
      <Heading as="h4" ui-size="md">
        {labels.pageTitle}
      </Heading>
      <Text ui-size="sm" tone="muted">
        {labels.pageDescription}
      </Text>
    </div>
    <Button size="sm">{labels.save}</Button>
  </PageHeader>
</Preview>

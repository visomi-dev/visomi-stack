---
import { recipeNames, uiDocs, type UiComponent, type UiLocale } from '../../ui-docs';
import Code from '../code.astro';
import Disclosure from '../disclosure.astro';

type Props = { id: UiComponent; locale: UiLocale; angular: string; astro: string };
const { id, locale, angular, astro } = Astro.props;
const labels = uiDocs[locale];
---

<section id={id} data-component={id} class="scroll-mt-28 border-t border-zinc-200 py-8 dark:border-zinc-800">
  <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
    <h3 class="font-heading text-xl font-semibold">{labels.names[id]}</h3>
    <code class="font-mono text-xs text-zinc-500 dark:text-zinc-400">{recipeNames[id]}.classes()</code>
  </div>
  <div data-preview class="rounded-xl border border-zinc-200 bg-white p-5 sm:p-7 dark:border-zinc-700 dark:bg-zinc-950">
    <slot />
  </div>
  <Disclosure summary={labels.usage} class="mt-4">
    <div class="grid min-w-0 gap-5 py-2">
      <div class="min-w-0">
        <h4 class="mb-2 text-sm font-medium">Angular</h4>
        <pre><Code block>{angular}</Code></pre>
      </div>
      <div class="min-w-0">
        <h4 class="mb-2 text-sm font-medium">Astro</h4>
        <pre><Code block>{astro}</Code></pre>
      </div>
      <div class="min-w-0">
        <h4 class="mb-2 text-sm font-medium">{labels.recipe}</h4>
        <pre><Code block>{`import { ${recipeNames[id]} } from '@visomi-stack/web-frontend-ui';\n\n${recipeNames[id]}.classes();`}</Code></pre>
      </div>
    </div>
  </Disclosure>
</section>

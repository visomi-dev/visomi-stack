---
import type { HTMLAttributes } from 'astro/types';

import { container as styles, type ContainerWidth, type ContainerGutter } from '@visomi-stack/web-frontend-ui';

type Props = HTMLAttributes<'div'> & { width?: ContainerWidth; gutter?: ContainerGutter; as?: 'div' | 'section' };

const { width = 'lg', gutter = 'default', as: Tag = 'div', class: className, ...attributes } = Astro.props;
---

<Tag {...attributes} class:list={[styles.classes({ width, gutter }), className]}>
  <slot />
</Tag>

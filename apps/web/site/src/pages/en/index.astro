---
import { APP_NAME } from '../../content/brand';
import LandingPage from '../../components/landing-page.astro';
import { getSiteContent } from '../../content/site-content';
import BaseLayout from '../../layouts/base-layout.astro';

const copy = getSiteContent('en');
---

<BaseLayout
  lang="en"
  locale="en"
  page="home"
  title={`${APP_NAME} | One origin with explicit runtime and trust boundaries`}
  description={copy.description}
>
  <LandingPage locale="en" />
</BaseLayout>

---
import BrandMark from '../../components/brand-mark.astro';
import ThemeSwitcher from '../../components/theme-switcher.astro';
import BaseLayout from '../../layouts/base-layout.astro';

const runtimeDocs = [
  [
    'System architecture',
    'docs/architecture/system/',
    'Runtime boundaries, deployment shape, synchronization, and operational audits.',
  ],
  [
    'Backend contracts',
    'docs/architecture/backend/',
    'Authentication, authorization, API contracts, tenancy, workers, and realtime behavior.',
  ],
  [
    'Design system',
    'docs/design-system/',
    'Tokens, component catalog, accessible interaction patterns, and implementation recipes.',
  ],
  [
    'Delivery roadmap',
    'docs/constitution/roadmap.md',
    'Completed foundations, active phases, and the intended order of product work.',
  ],
  ['Decision records', 'docs/architecture/adr/', 'The durable context behind architectural and platform decisions.'],
  [
    'Feature specifications',
    'docs/specs/',
    'Requirements, plans, validation matrices, and implementation evidence for each feature.',
  ],
];

const flowSteps = [
  ['01', 'Intent', 'Astro serves public content or Angular SSR receives authenticated product intent.'],
  ['02', 'Policy', 'The API validates schema, identity, tenant context, and capability before dispatch.'],
  ['03', 'Execution', 'Synchronous work returns immediately; durable jobs move through Redis and BullMQ.'],
  ['04', 'Projection', 'Realtime publishes authorized updates while encrypted payloads remain opaque to the cloud.'],
];
---

<BaseLayout
  lang="en"
  locale="en"
  page="home"
  title="Visomi Stack Documentation | Architecture, security, and delivery"
  description="Explore the Visomi Stack runtime map, trust boundaries, request lifecycle, design system, and repository documentation."
>
  <header
    class="sticky top-0 z-50 border-b border-zinc-950/10 bg-white/85 px-4 py-4 backdrop-blur-xl md:px-10 dark:border-white/10 dark:bg-zinc-950/85"
  >
    <nav class="mx-auto flex max-w-7xl items-center justify-between" aria-label="Documentation navigation">
      <a href="/en/" class="flex items-center gap-3 font-mono text-sm font-bold tracking-[0.18em] uppercase">
        <BrandMark />
        <span class="hidden sm:inline">visomi<span class="text-zinc-400">/</span>stack</span>
      </a>
      <div class="flex items-center gap-3">
        <a
          class="text-sm font-semibold text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400"
          href="/en/">Home</a
        >
        <ThemeSwitcher />
        <a
          class="rounded-md bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700 dark:bg-blue-500 dark:text-zinc-950 dark:hover:bg-blue-400"
          href="/app/en/">Open app</a
        >
      </div>
    </nav>
  </header>

  <main class="bg-white text-zinc-950 dark:bg-zinc-950 dark:text-zinc-50">
    <section
      class="relative overflow-hidden border-b border-zinc-950/10 px-4 py-20 md:px-10 md:py-28 dark:border-white/10"
    >
      <div class="hero-grid pointer-events-none absolute inset-0 opacity-60"></div>
      <div class="relative mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <div>
          <p class="font-mono text-xs font-bold tracking-[0.24em] text-blue-600 uppercase dark:text-blue-400">
            Documentation / system map
          </p>
          <h1 class="font-heading mt-6 text-5xl leading-[0.95] font-extrabold tracking-[-0.06em] md:text-7xl">
            Understand the whole stack before changing one layer.
          </h1>
        </div>
        <div class="lg:pb-2">
          <p class="max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
            Visomi Stack separates public delivery, authenticated product behavior, runtime execution, and durable
            storage while keeping their contracts visible in one Nx graph.
          </p>
          <div class="mt-8 flex flex-wrap gap-2 font-mono text-xs text-zinc-600 dark:text-zinc-400">
            <span class="rounded-md bg-zinc-100 px-3 py-2 dark:bg-zinc-900">Angular 22</span>
            <span class="rounded-md bg-zinc-100 px-3 py-2 dark:bg-zinc-900">Astro</span>
            <span class="rounded-md bg-zinc-100 px-3 py-2 dark:bg-zinc-900">Node</span>
            <span class="rounded-md bg-zinc-100 px-3 py-2 dark:bg-zinc-900">Nx</span>
            <span class="rounded-md bg-zinc-100 px-3 py-2 dark:bg-zinc-900">PostgreSQL + Redis</span>
          </div>
        </div>
      </div>
    </section>

    <section
      class="border-b border-zinc-950/10 bg-zinc-50 px-4 py-16 md:px-10 md:py-24 dark:border-white/10 dark:bg-zinc-900/40"
    >
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
          <div>
            <p class="font-mono text-xs font-bold tracking-[0.2em] text-blue-600 uppercase dark:text-blue-400">
              Runtime topology
            </p>
            <h2 class="font-heading mt-4 text-4xl font-extrabold tracking-[-0.04em]">
              Boundaries you can reason about.
            </h2>
            <p class="mt-5 leading-7 text-zinc-600 dark:text-zinc-400">
              Solid lines are request paths. Dashed lines are asynchronous or realtime paths. The client vault is
              deliberately outside the cloud trust boundary.
            </p>
          </div>

          <figure
            class="overflow-x-auto rounded-lg border border-zinc-950/10 bg-white p-4 md:p-8 dark:border-white/10 dark:bg-zinc-950"
          >
            <svg viewBox="0 0 780 390" class="min-w-[680px]" role="img" aria-labelledby="runtime-title runtime-desc">
              <title id="runtime-title">Visomi Stack runtime topology</title>
              <desc id="runtime-desc"
                >Public Astro site and Angular application connect to an API gateway, worker, realtime runtime,
                PostgreSQL, Redis, and a client-side encrypted vault.</desc
              >
              <defs>
                <marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
                  ><path d="M0 0 8 4 0 8Z" class="fill-blue-600 dark:fill-blue-400"></path></marker
                >
              </defs>
              <g class="fill-none stroke-blue-600 dark:stroke-blue-400" stroke-width="2" marker-end="url(#arrow)">
                <path d="M150 90H280"></path><path d="M150 210H280"></path><path d="M420 150H540"></path><path
                  d="M350 190V285"></path><path d="M610 190V285"></path><path d="M420 330H540" stroke-dasharray="7 7"
                ></path>
              </g>
              <g class="fill-white stroke-zinc-300 dark:fill-zinc-900 dark:stroke-zinc-700" stroke-width="2">
                <rect x="20" y="50" width="130" height="80" rx="10"></rect><rect
                  x="20"
                  y="170"
                  width="130"
                  height="80"
                  rx="10"></rect>
                <rect x="280" y="110" width="140" height="80" rx="10"></rect><rect
                  x="540"
                  y="110"
                  width="140"
                  height="80"
                  rx="10"></rect>
                <rect x="280" y="285" width="140" height="80" rx="10"></rect><rect
                  x="540"
                  y="285"
                  width="140"
                  height="80"
                  rx="10"></rect>
              </g>
              <g class="fill-zinc-950 font-mono text-[13px] dark:fill-zinc-50" text-anchor="middle">
                <text x="85" y="82">PUBLIC SITE</text><text x="85" y="104" class="fill-zinc-500">Astro</text>
                <text x="85" y="202">PRODUCT APP</text><text x="85" y="224" class="fill-zinc-500">Angular SSR</text>
                <text x="350" y="143">API BOUNDARY</text><text x="350" y="165" class="fill-zinc-500"
                  >Express + OpenAPI</text
                >
                <text x="610" y="143">REALTIME</text><text x="610" y="165" class="fill-zinc-500">Socket.IO</text>
                <text x="350" y="318">DURABLE WORK</text><text x="350" y="340" class="fill-zinc-500">BullMQ worker</text
                >
                <text x="610" y="318">STATE</text><text x="610" y="340" class="fill-zinc-500">Postgres + Redis</text>
              </g>
              <g transform="translate(700 185)"
                ><circle r="34" class="fill-blue-600 dark:fill-blue-500"></circle><path
                  d="M-12 1h24M0 1v-13"
                  stroke="white"
                  stroke-width="3"
                  stroke-linecap="round"></path><text
                  y="54"
                  class="fill-zinc-500 font-mono text-[11px]"
                  text-anchor="middle">CLIENT VAULT</text
                ></g
              >
            </svg>
            <figcaption class="mt-4 border-t border-zinc-950/10 pt-4 text-sm text-zinc-500 dark:border-white/10">
              Cloud runtimes coordinate encrypted envelopes; protected product content is decrypted only on an
              authorized device.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="border-b border-zinc-950/10 px-4 py-16 md:px-10 md:py-24 dark:border-white/10">
      <div class="mx-auto max-w-7xl">
        <p class="font-mono text-xs font-bold tracking-[0.2em] text-blue-600 uppercase dark:text-blue-400">
          Request and event lifecycle
        </p>
        <div
          class="mt-10 grid border-l border-blue-600/50 md:grid-cols-4 md:border-t md:border-l-0 dark:border-blue-400/50"
        >
          {
            flowSteps.map(([number, title, body]) => (
              <article class="relative border-b border-zinc-950/10 py-6 pl-6 md:border-r md:border-b-0 md:px-6 md:pt-8 dark:border-white/10">
                <span class="absolute top-8 -left-[5px] h-2 w-2 rounded-full bg-blue-600 md:-top-[5px] md:left-6 dark:bg-blue-400" />
                <p class="font-mono text-xs text-blue-600 dark:text-blue-400">{number}</p>
                <h2 class="font-heading mt-6 text-xl font-bold">{title}</h2>
                <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-zinc-100 px-4 py-16 md:px-10 md:py-24 dark:bg-zinc-900">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <p class="font-mono text-xs font-bold tracking-[0.2em] text-blue-600 uppercase dark:text-blue-400">
            Repository guide
          </p>
          <h2 class="font-heading mt-4 text-4xl font-extrabold tracking-[-0.04em] md:text-5xl">
            Documentation is part of the system.
          </h2>
          <p class="mt-5 text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Use these sources to understand intent before implementation. Specifications explain what must change;
            architecture and ADRs explain what must remain true.
          </p>
        </div>
        <div
          class="mt-12 grid gap-px overflow-hidden rounded-lg border border-zinc-950/10 bg-zinc-950/10 md:grid-cols-2 lg:grid-cols-3 dark:border-white/10 dark:bg-white/10"
        >
          {
            runtimeDocs.map(([title, path, description], index) => (
              <article class="bg-zinc-100 p-6 dark:bg-zinc-900">
                <div class="flex items-center justify-between">
                  <>
                    <span class="font-mono text-xs text-blue-600 dark:text-blue-400">0{index + 1}</span>
                    <code class="text-xs text-zinc-500">{path}</code>
                  </>
                </div>
                <h3 class="font-heading mt-8 text-xl font-bold">{title}</h3>
                <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{description}</p>
              </article>
            ))
          }
        </div>
        <div class="mt-12 rounded-lg bg-zinc-950 p-6 text-zinc-50 md:flex md:items-center md:justify-between md:p-8">
          <div>
            <p class="font-mono text-xs text-blue-400">QUICK START</p><p class="font-heading mt-2 text-2xl font-bold">
              Inspect the workspace, then run one focused target.
            </p>
          </div>
          <code
            class="mt-6 block overflow-x-auto rounded-md bg-white/10 px-4 py-3 font-mono text-sm text-blue-300 md:mt-0"
            >pnpm nx show projects --json</code
          >
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

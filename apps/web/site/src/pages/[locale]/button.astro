---
import BaseLayout from '../../layouts/base.astro';

import Button from '../../components/button.astro';
import Link from '../../components/link.astro';
import demoScript from '../../scripts/button-demo.js?url&no-inline';

const locale = Astro.params.locale;
if (locale !== 'en' && locale !== 'es') return new Response(null, { status: 404 });
const spanish = locale === 'es';
const text = spanish
  ? {
      title: 'Estilos del botón compartido',
      description: 'Controles nativos de Astro con las mismas clases Tailwind que la aplicación Angular.',
      increment: 'Sumar uno',
      reset: 'Reiniciar',
      disabled: 'No disponible',
      submit: 'Enviar formulario',
      submitted: 'Formulario enviado.',
      count: 'Activaciones:',
      home: 'Volver a los fundamentos',
      theme: 'Apariencia',
      system: 'Sistema',
      light: 'Claro',
      dark: 'Oscuro',
    }
  : {
      title: 'Shared button styles',
      description: 'Native Astro controls using the same Tailwind classes as the Angular application.',
      increment: 'Add one',
      reset: 'Reset',
      disabled: 'Unavailable',
      submit: 'Submit form',
      submitted: 'Form submitted.',
      count: 'Activations:',
      home: 'Back to foundations',
      theme: 'Appearance',
      system: 'System',
      light: 'Light',
      dark: 'Dark',
    };
---

<BaseLayout locale={locale} title={text.title}>
  <script slot="head" is:inline type="module" src={demoScript}></script>
  <main class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
    <Link href={`/${locale}/foundations/`}>{text.home}</Link>
    <h1 class="mt-8 font-heading text-3xl font-semibold">{text.title}</h1>
    <p class="mt-4 max-w-2xl text-zinc-600 dark:text-zinc-400">{text.description}</p>
    <section class="mt-8 rounded-xl border border-zinc-200 p-6 dark:border-zinc-700" data-button-demo>
      <div class="flex flex-wrap gap-4">
        <Button data-increment>{text.increment}</Button>
        <Button variant="secondary" size="sm" data-reset>
          {text.reset}
        </Button>
        <Button disabled data-disabled>
          {text.disabled}
        </Button>
      </div>
      <p class="mt-5">
        {text.count}{' '}
        <output aria-live="polite" data-count>
          0
        </output>
      </p>
      <form method="get" action={`/${locale}/button/`} class="mt-6">
        <Button type="submit" name="action" value="submit" variant="secondary" size="sm">
          {text.submit}
        </Button>
      </form>
      <p class="mt-4" role="status">
        {Astro.url.searchParams.get('action') === 'submit' ? text.submitted : ''}
      </p>
    </section>
    <label class="mt-8 flex items-center gap-3">
      {text.theme}
      <select
        data-theme-select
        class="ui-focus-ring min-h-11 rounded-lg border border-zinc-500 bg-white px-3 text-zinc-950 dark:bg-zinc-900 dark:text-zinc-50"
      >
        <option value="system">{text.system}</option>
        <option value="light">{text.light}</option>
        <option value="dark">{text.dark}</option>
      </select>
    </label>
  </main>
</BaseLayout>

---
import SiteLayout from '../../layouts/site.astro';
import { messages } from '../../i18n';
import { isSiteLocale } from '../../content/site';
const locale = Astro.params.locale;
if (!isSiteLocale(locale)) return new Response(null, { status: 404 });
const text = messages[locale];
---

<SiteLayout locale={locale} page="foundations" title={text.foundations} description={text.intro}>
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="mb-5 flex items-center gap-3 font-mono text-xs tracking-wider text-blue-700 dark:text-blue-400">
      <span aria-hidden="true" class="h-px w-8 bg-current"></span>01 / {text.foundations}
    </div>
    <h1 class="max-w-3xl font-heading text-4xl leading-tight font-semibold tracking-tight sm:text-6xl">{text.title}</h1>
    <p class="text-pretty leading-[1.7] sm:leading-7 mt-6 max-w-2xl text-base text-zinc-600 sm:text-lg dark:text-zinc-400">
      {text.intro}
    </p>
    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      <section class="rounded-xl border border-zinc-200 bg-zinc-50 text-zinc-950 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50 p-6 sm:p-7">
        <h2 class="font-heading text-lg font-semibold">{text.type}</h2>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{text.typeNote}</p>
        <div class="mt-10 font-heading text-6xl font-semibold tracking-tight">Aa</div>
        <p class="mt-6 text-sm leading-7">{text.body}</p>
        <p class="mt-6 border-t border-zinc-200 pt-4 font-mono text-xs text-zinc-600 dark:border-zinc-700 dark:text-zinc-400">
          {text.mono}
        </p>
      </section>
      <section class="rounded-xl border border-zinc-200 bg-zinc-50 text-zinc-950 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50 p-6 sm:p-7">
        <h2 class="font-heading text-lg font-semibold">{text.surfaces}</h2>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{text.surfaceNote}</p>
        <div class="mt-8 grid gap-3 text-sm">
          <div class="rounded-xl border border-zinc-300 bg-white p-4 dark:border-zinc-600 dark:bg-zinc-950">
            {text.canvas}
          </div>
          <div class="rounded-xl border border-zinc-200 bg-zinc-50 text-zinc-950 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50 p-4">
            {text.panel}
          </div>
          <div class="rounded-xl border border-zinc-200 bg-zinc-100 text-zinc-950 shadow-2xl shadow-zinc-950/8 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-50 p-4">
            {text.raised}
          </div>
        </div>
      </section>
      <section class="rounded-xl border border-zinc-200 bg-zinc-50 text-zinc-950 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50 p-6 sm:p-7">
        <h2 class="font-heading text-lg font-semibold">{text.palette}</h2>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{text.paletteNote}</p>
        <div class="mt-8 rounded-lg bg-blue-600 p-4 text-sm font-medium text-white">{text.brand}</div>
        <ul class="mt-6 space-y-4 text-sm">
          <li class="text-green-800 dark:text-green-300">✓ {text.success}</li>
          <li class="text-amber-800 dark:text-amber-300">! {text.warning}</li>
          <li class="text-red-700 dark:text-red-300">× {text.danger}</li>
        </ul>
      </section>
    </div>
  </div>
</SiteLayout>

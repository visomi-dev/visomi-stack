---
import BaseLayout from '../../../layouts/base.astro';
import AppShell from '../../../components/app-shell.astro';
import Sidebar from '../../../components/sidebar.astro';
import Topbar from '../../../components/topbar.astro';
import Navbar from '../../../components/navbar.astro';
import NavItem from '../../../components/nav-item.astro';
import Card from '../../../components/card.astro';
import LinkButton from '../../../components/link-button.astro';
import Link from '../../../components/link.astro';
import { uiDocs } from '../../../ui-docs';
const locale = Astro.params.locale;
if (locale !== 'en' && locale !== 'es') return new Response(null, { status: 404 });
const labels = uiDocs[locale];
const destinations = [
  { href: `/${locale}/ui/shell/`, label: labels.home, path: 'M3 10 12 3l9 7v11h-6v-7H9v7H3Z', current: true },
  { href: '#shell-activity', label: labels.activity, path: 'M4 4h16v16H4zM4 9h16M9 9v11', current: false },
  {
    href: '#shell-settings',
    label: labels.settings,
    path: 'M4 5h16M4 12h16M4 19h16M8 3v4M16 10v4M10 17v4',
    current: false,
  },
];
---

<BaseLayout locale={locale} title={labels.names['app-shell']} description={labels.shellNote}>
  <AppShell contentId="shell-main" skipLabel={labels.skipContent}>
    <Sidebar slot="sidebar" label={labels.primaryNavigation}>
      <a
        slot="brand"
        href={`/${locale}/ui/`}
        class="ui-focus-ring flex min-h-11 items-center gap-3 rounded-lg font-heading font-bold"
      >
        <span class="rounded-lg bg-blue-600 px-3 py-2 text-white">V</span> VISOMI
      </a>
      <div class="space-y-1">
        {destinations.map((item) => (
          <NavItem href={item.href} aria-current={item.current ? 'page' : undefined}>
            <svg
              data-slot="icon"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d={item.path} />
            </svg>
            <span>{item.label}</span>
          </NavItem>
        ))}
      </div>
      <p
        slot="footer"
        class="border-t border-zinc-200 pt-4 text-xs text-zinc-600 dark:border-zinc-700 dark:text-zinc-400"
      >
        {labels.shellFooter}
      </p>
    </Sidebar>
    <Topbar slot="header">
      <span slot="title">{labels.workspace}</span>
      <Link href={`/${locale}/ui/`} variant="muted" class="inline-flex min-h-11 items-center px-2 text-sm">
        {labels.catalogLink}
      </Link>
      <label class="flex items-center gap-2 text-sm">
        <span>{labels.theme}</span>
        <select
          data-theme-select
          class="ui-focus-ring min-h-11 rounded-lg border border-zinc-500 bg-white px-2 text-zinc-950 dark:bg-zinc-900 dark:text-zinc-50"
        >
          <option value="system">{labels.system}</option>
          <option value="light">{labels.light}</option>
          <option value="dark">{labels.dark}</option>
        </select>
      </label>
    </Topbar>
    <header class="mb-8 grid gap-4">
      <p class="font-mono text-xs tracking-wide text-blue-700 dark:text-blue-400">VISOMI / APP SHELL</p>
      <h1 class="max-w-2xl font-heading text-3xl font-semibold tracking-tight sm:text-5xl">{labels.shellTitle}</h1>
      <p class="max-w-2xl text-pretty text-zinc-600 dark:text-zinc-400">{labels.shellNote}</p>
    </header>
    <div class="grid gap-5 sm:grid-cols-2">
      <Card>
        <h2 class="font-heading text-lg font-semibold">{labels.studio}</h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">{labels.cardBody}</p>
      </Card>
      <Card tone="raised">
        <h2 class="font-heading text-lg font-semibold">{labels.sandbox}</h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">{labels.containerNote}</p>
      </Card>
    </div>
    <section
      id="shell-activity"
      class="mt-10 min-h-72 scroll-mt-28 rounded-xl border border-zinc-200 p-6 dark:border-zinc-700"
    >
      <h2 class="font-heading text-xl font-semibold">{labels.activity}</h2>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400">{labels.note}</p>
    </section>
    <section
      id="shell-settings"
      class="mt-8 min-h-72 scroll-mt-28 rounded-xl border border-zinc-200 p-6 dark:border-zinc-700"
    >
      <h2 class="mb-5 font-heading text-xl font-semibold">{labels.settings}</h2>
      <LinkButton href={`/${locale}/ui/`}>{labels.catalogLink}</LinkButton>
    </section>
    <footer
      slot="footer"
      class="border-t border-zinc-200 px-5 py-6 text-xs text-zinc-600 sm:px-8 dark:border-zinc-800 dark:text-zinc-400"
    >
      {labels.shellFooter}
    </footer>
    <Navbar slot="mobile" aria-label={labels.primaryNavigation}>
      {destinations.map((item) => (
        <NavItem placement="navbar" href={item.href} aria-current={item.current ? 'page' : undefined}>
          <svg
            data-slot="icon"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d={item.path} />
          </svg>
          <span>{item.label}</span>
        </NavItem>
      ))}
    </Navbar>
  </AppShell>
</BaseLayout>

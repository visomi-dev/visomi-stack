---
import SiteLayout from '../../layouts/site.astro';
import { isSiteLocale, siteCopy, sitePath, repositoryUrl } from '../../content/site';
import Terminal from '../../components/site/terminal.astro';
import Icon from '../../components/site/icon.astro';
import LinkButton from '../../components/link-button.astro';
import Link from '../../components/link.astro';
const locale = Astro.params.locale;
if (!isSiteLocale(locale)) return new Response(null, { status: 404 });
const labels = siteCopy[locale];
const copy = labels.docs;
const sections = [
  ['requirements', copy.requirements],
  ['workspace', copy.stepOne],
  ['entry-points', copy.stepTwo],
  ['structure', copy.stepThree],
  ['verification', copy.checksTitle],
];
const clone = `git clone https://github.com/visomi-dev/visomi-stack.git
cd visomi-stack
pnpm install --frozen-lockfile`;
---

<SiteLayout locale={locale} page="docs" title={copy.title} description={copy.description}>
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16">
    <aside class="hidden lg:block">
      <nav aria-label={labels.nav.docs} class="sticky top-28 grid gap-1">
        <p class="mb-4 font-mono text-xs text-blue-700 dark:text-blue-400">
          {locale === 'es' ? 'PRIMEROS PASOS' : 'GETTING STARTED'}
        </p>
        {sections.map(([id, title]) => (
          <Link
            href={`#${id}`}
            variant="muted"
            underline="none"
            class="flex min-h-11 items-center px-2 text-sm hover:bg-zinc-100 dark:hover:bg-zinc-900"
          >
            {title}
          </Link>
        ))}
      </nav>
    </aside>
    <div class="min-w-0 max-w-4xl">
      <header>
        <p class="mb-6 font-mono text-xs leading-6 tracking-widest text-blue-700 dark:text-blue-400">{copy.eyebrow}</p>
        <h1 class="max-w-3xl font-heading text-4xl leading-tight font-semibold tracking-[-0.045em] text-balance sm:text-6xl">
          {copy.title}
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">{copy.intro}</p>
      </header>
      <nav aria-label={labels.nav.docs} class="mt-8 flex flex-wrap gap-2 lg:hidden">
        {sections.map(([id, title]) => (
          <Link
            href={`#${id}`}
            variant="muted"
            underline="none"
            class="inline-flex min-h-11 items-center border border-zinc-300 px-3 text-xs dark:border-zinc-700"
          >
            {title}
          </Link>
        ))}
      </nav>
      <section
        id="requirements"
        class="mt-12 scroll-mt-28 rounded-xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-700 dark:bg-zinc-900/50"
      >
        <h2 class="font-heading text-xl font-semibold">{copy.requirements}</h2>
        <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{copy.requirementsBody}</p>
        <ul class="mt-5 flex flex-wrap gap-3 font-mono text-xs">
          <li class="rounded-lg border border-zinc-300 px-3 py-2 dark:border-zinc-700">Node 24.15.0</li>
          <li class="rounded-lg border border-zinc-300 px-3 py-2 dark:border-zinc-700">pnpm 12.15.0</li>
          <li class="rounded-lg border border-zinc-300 px-3 py-2 dark:border-zinc-700">Git</li>
        </ul>
      </section>
      <section id="workspace" class="mt-14 scroll-mt-28">
        <h2 class="font-heading text-2xl font-semibold tracking-tight">
          <span class="mr-3 font-mono text-sm text-blue-700 dark:text-blue-400">01</span>
          {copy.stepOne}
        </h2>
        <p class="mt-4 mb-6 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{copy.stepOneBody}</p>
        <Terminal title="terminal / workspace" code={clone} />
      </section>
      <section id="entry-points" class="mt-14 scroll-mt-28">
        <h2 class="font-heading text-2xl font-semibold tracking-tight">
          <span class="mr-3 font-mono text-sm text-blue-700 dark:text-blue-400">02</span>
          {copy.stepTwo}
        </h2>
        <p class="mt-4 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{copy.stepTwoBody}</p>
        <div class="mt-7 grid gap-7">
          {copy.entries.map(([title, body, command, url]) => (
            <article class="min-w-0">
              <h3 class="font-heading text-lg font-semibold">{title}</h3>
              <p class="mt-2 mb-4 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{body}</p>
              <Terminal title={title} code={command} />
              <p class="mt-3 break-all font-mono text-xs leading-6 text-zinc-500 dark:text-zinc-400">
                {locale === 'es' ? 'Abrir' : 'Open'}: {url.replace('/en/', `/${locale}/`)}
              </p>
            </article>
          ))}
        </div>
        <div class="mt-8 rounded-xl border-l-4 border-blue-600 bg-blue-50 p-5 dark:bg-blue-950/40">
          <h3 class="text-sm font-semibold">{copy.authNoteTitle}</h3>
          <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-300">{copy.authNoteBody}</p>
          <Link
            href={`${repositoryUrl}/blob/main/apps/web/api/README.md`}
            underline="none"
            class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-medium"
          >
            {labels.apiGuide}
            <Icon name="arrow-right" class="size-4" />
          </Link>
        </div>
      </section>
      <section id="structure" class="mt-14 scroll-mt-28">
        <h2 class="font-heading text-2xl font-semibold tracking-tight">
          <span class="mr-3 font-mono text-sm text-blue-700 dark:text-blue-400">03</span>
          {copy.stepThree}
        </h2>
        <p class="mt-4 mb-6 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{copy.stepThreeBody}</p>
        <Terminal title="visomi-stack / workspace" code={copy.structure} />
      </section>
      <section id="verification" class="mt-14 scroll-mt-28">
        <h2 class="font-heading text-2xl font-semibold tracking-tight">{copy.checksTitle}</h2>
        <p class="mt-4 mb-6 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{copy.checksBody}</p>
        <Terminal
          title="terminal / Nx"
          code={`pnpm nx run-many -t build lint typecheck -p web-site
pnpm nx e2e web-site`}
        />
      </section>
      <section class="mt-14 border-t border-zinc-200 pt-10 dark:border-zinc-800">
        <h2 class="font-heading text-2xl font-semibold tracking-tight">{copy.nextTitle}</h2>
        <div class="mt-7 grid gap-4">
          {copy.nextItems.map(([page, title, body]) => (
            <a
              href={sitePath(locale, page)}
              class="ui-focus-ring group flex items-center justify-between gap-6 rounded-xl border border-zinc-200 p-5 hover:border-blue-300 dark:border-zinc-800 dark:hover:border-blue-800"
            >
              <div>
                <h3 class="text-base font-semibold">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{body}</p>
              </div>
              <Icon name="arrow-right" class="size-5 shrink-0 text-blue-700 dark:text-blue-400" />
            </a>
          ))}
        </div>
        <div class="mt-8">
          <LinkButton href={repositoryUrl} variant="secondary">
            {labels.source}
            <Icon name="arrow-right" class="size-4" />
          </LinkButton>
        </div>
      </section>
    </div>
  </div>
</SiteLayout>

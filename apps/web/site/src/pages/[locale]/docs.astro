---
import { card } from '@visomi-stack/web-frontend-ui';
import Badge from '../../components/badge.astro';
import Alert from '../../components/alert.astro';
import Container from '../../components/container.astro';
import Card from '../../components/card.astro';
import Text from '../../components/text.astro';
import Heading from '../../components/heading.astro';
import SiteLayout from '../../layouts/site.astro';
import { isSiteLocale, siteCopy, sitePath, repositoryUrl } from '../../content/site';
import Terminal from '../../components/site/terminal.astro';
import Icon from '../../components/site/icon.astro';
import LinkButton from '../../components/link-button.astro';
import Link from '../../components/link.astro';
const locale = Astro.params.locale;
if (!isSiteLocale(locale)) return new Response(null, { status: 404 });
const labels = siteCopy[locale];
const copy = labels.docs;
const sections = [
  ['requirements', copy.requirements],
  ['workspace', copy.stepOne],
  ['entry-points', copy.stepTwo],
  ['structure', copy.stepThree],
  ['verification', copy.checksTitle],
];
const clone = `git clone https://github.com/visomi-dev/visomi-stack.git
cd visomi-stack
pnpm install --frozen-lockfile`;
---

<SiteLayout locale={locale} page="docs" title={copy.title} description={copy.description}>
  <Container
    as="div"
    width="xl"
    gutter="compact"
    class="grid gap-12 py-14 sm:py-20 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16"
  >
    <aside class="hidden lg:block">
      <nav aria-label={labels.nav.docs} class="sticky top-28 grid gap-1">
        <Text uiSize="xs" tone="accent" mono class="mb-4">
          {locale === 'es' ? 'PRIMEROS PASOS' : 'GETTING STARTED'}
        </Text>
        {sections.map(([id, title]) => (
          <Link
            href={`#${id}`}
            variant="muted"
            underline="none"
            class="flex min-h-11 items-center px-2 text-sm hover:bg-zinc-100 dark:hover:bg-zinc-900"
          >
            {title}
          </Link>
        ))}
      </nav>
    </aside>
    <div class="min-w-0 max-w-4xl">
      <header>
        <Text uiSize="xs" tone="accent" mono leading="relaxed" class="mb-6 tracking-widest">
          {copy.eyebrow}
        </Text>
        <Heading as="h1" uiSize="display" class="max-w-3xl">
          {copy.title}
        </Heading>
        <Text uiSize="lg" tone="muted" class="mt-7 max-w-2xl">
          {copy.intro}
        </Text>
      </header>
      <nav aria-label={labels.nav.docs} class="mt-8 flex flex-wrap gap-2 lg:hidden">
        {sections.map(([id, title]) => (
          <Link
            href={`#${id}`}
            variant="muted"
            underline="none"
            class="inline-flex min-h-11 items-center border border-zinc-300 px-3 text-xs dark:border-zinc-700"
          >
            {title}
          </Link>
        ))}
      </nav>
      <Card as="section" tone="subtle" padding="lg" layout="plain" id="requirements" class="mt-12 scroll-mt-28">
        <Heading as="h2" uiSize="md">
          {copy.requirements}
        </Heading>
        <Text uiSize="sm" tone="muted" leading="relaxed" class="mt-3">
          {copy.requirementsBody}
        </Text>
        <ul class="mt-5 flex flex-wrap gap-3 font-mono text-xs">
          <li>
            <Badge>Node 24.15.0</Badge>
          </li>
          <li>
            <Badge>pnpm 12.15.0</Badge>
          </li>
          <li>
            <Badge>Git</Badge>
          </li>
        </ul>
      </Card>
      <section id="workspace" class="mt-14 scroll-mt-28">
        <Heading as="h2" uiSize="lg">
          <Text as="span" uiSize="sm" tone="accent" mono class="mr-3">
            01
          </Text>
          {copy.stepOne}
        </Heading>
        <Text uiSize="sm" tone="muted" leading="relaxed" class="mt-4 mb-6">
          {copy.stepOneBody}
        </Text>
        <Terminal title="terminal / workspace" code={clone} />
      </section>
      <section id="entry-points" class="mt-14 scroll-mt-28">
        <Heading as="h2" uiSize="lg">
          <Text as="span" uiSize="sm" tone="accent" mono class="mr-3">
            02
          </Text>
          {copy.stepTwo}
        </Heading>
        <Text uiSize="sm" tone="muted" leading="relaxed" class="mt-4">
          {copy.stepTwoBody}
        </Text>
        <div class="mt-7 grid gap-7">
          {copy.entries.map(([title, body, command, url]) => (
            <article class="min-w-0">
              <Heading as="h3" uiSize="sm">
                {title}
              </Heading>
              <Text uiSize="sm" tone="muted" leading="relaxed" class="mt-2 mb-4">
                {body}
              </Text>
              <Terminal title={title} code={command} />
              <Text uiSize="xs" tone="subtle" mono leading="relaxed" class="mt-3 break-all">
                {locale === 'es' ? 'Abrir' : 'Open'}: {url.replace('/en/', `/${locale}/`)}
              </Text>
            </article>
          ))}
        </div>
        <Alert tone="accent" class="mt-8">
          <Heading as="h3" uiSize="label">
            {copy.authNoteTitle}
          </Heading>
          <Text uiSize="sm" tone="muted" leading="relaxed" class="mt-3">
            {copy.authNoteBody}
          </Text>
          <Link
            href={`${repositoryUrl}/blob/main/apps/web/api/README.md`}
            underline="none"
            class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-medium"
          >
            {labels.apiGuide}
            <Icon name="arrow-right" class="size-4" />
          </Link>
        </Alert>
      </section>
      <section id="structure" class="mt-14 scroll-mt-28">
        <Heading as="h2" uiSize="lg">
          <Text as="span" uiSize="sm" tone="accent" mono class="mr-3">
            03
          </Text>
          {copy.stepThree}
        </Heading>
        <Text uiSize="sm" tone="muted" leading="relaxed" class="mt-4 mb-6">
          {copy.stepThreeBody}
        </Text>
        <Terminal title="visomi-stack / workspace" code={copy.structure} />
      </section>
      <section id="verification" class="mt-14 scroll-mt-28">
        <Heading as="h2" uiSize="lg">
          {copy.checksTitle}
        </Heading>
        <Text uiSize="sm" tone="muted" leading="relaxed" class="mt-4 mb-6">
          {copy.checksBody}
        </Text>
        <Terminal
          title="terminal / Nx"
          code={`pnpm nx run-many -t build lint typecheck -p web-site
pnpm nx e2e web-site`}
        />
      </section>
      <section class="mt-14 border-t border-zinc-200 pt-10 dark:border-zinc-800">
        <Heading as="h2" uiSize="lg">
          {copy.nextTitle}
        </Heading>
        <div class="mt-7 grid gap-4">
          {copy.nextItems.map(([page, title, body]) => (
            <a
              href={sitePath(locale, page)}
              class:list={[
                card.classes({ padding: 'md', layout: 'plain' }),
                'ui-focus-ring group flex items-center justify-between gap-6 hover:border-blue-300 dark:hover:border-blue-800',
              ]}
            >
              <div>
                <Heading as="h3" uiSize="label">
                  {title}
                </Heading>
                <Text uiSize="sm" tone="muted" class="mt-2">
                  {body}
                </Text>
              </div>
              <Icon name="arrow-right" class="size-5 shrink-0 text-blue-700 dark:text-blue-400" />
            </a>
          ))}
        </div>
        <div class="mt-8">
          <LinkButton href={repositoryUrl} variant="secondary">
            {labels.source}
            <Icon name="arrow-right" class="size-4" />
          </LinkButton>
        </div>
      </section>
    </div>
  </Container>
</SiteLayout>

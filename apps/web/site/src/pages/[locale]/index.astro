---
import SiteLayout from '../../layouts/site.astro';
import { isSiteLocale, siteCopy, sitePath } from '../../content/site';
import ProductPreview from '../../components/site/product-preview.astro';
import RuntimeMap from '../../components/site/runtime-map.astro';
import SectionHeading from '../../components/site/section-heading.astro';
import Terminal from '../../components/site/terminal.astro';
import Icon from '../../components/site/icon.astro';
import LinkButton from '../../components/link-button.astro';
import Link from '../../components/link.astro';
import Field from '../../components/field.astro';
import Input from '../../components/input.astro';
import Checkbox from '../../components/checkbox.astro';
import Disclosure from '../../components/disclosure.astro';
import { componentGroups } from '../../ui-docs';
const locale = Astro.params.locale;
if (!isSiteLocale(locale)) return new Response(null, { status: 404 });
const labels = siteCopy[locale];
const copy = labels.home;
const count = Object.values(componentGroups).flat().length;
---

<SiteLayout locale={locale} page="home" title={copy.title} description={copy.description}>
  <section
    class="relative isolate overflow-hidden border-b border-zinc-200 dark:border-zinc-800"
    aria-labelledby="hero-title"
  >
    <div
      class="pointer-events-none absolute inset-y-0 right-0 -z-10 w-1/2 bg-linear-to-l from-blue-50/70 to-transparent dark:from-blue-950/25"
      aria-hidden="true"
    ></div>
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 pt-14 pb-16 sm:px-8 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:pt-20 lg:pb-24">
      <div class="min-w-0">
        <p class="mb-7 flex items-center gap-3 font-mono text-[0.65rem] leading-6 tracking-widest text-blue-700 sm:text-xs dark:text-blue-400">
          <span class="h-px w-7 shrink-0 bg-current" aria-hidden="true"></span>
          {copy.eyebrow}
        </p>
        <h1
          id="hero-title"
          class="max-w-2xl font-heading text-5xl leading-[1.08] font-semibold tracking-[-0.055em] text-balance sm:text-6xl lg:text-7xl"
        >
          {copy.headline} <span class="mt-2 block text-blue-700 dark:text-blue-400">{copy.accent}</span>
        </h1>
        <p class="mt-7 max-w-xl text-base leading-8 text-pretty text-zinc-600 sm:text-lg dark:text-zinc-400">
          {copy.intro}
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <LinkButton href={sitePath(locale, 'docs')}>
            {labels.start}
            <Icon name="arrow-right" class="size-4" />
          </LinkButton>
          <LinkButton href={sitePath(locale, 'architecture')} variant="secondary">
            {copy.secondary}
          </LinkButton>
        </div>
        <ul class="mt-9 grid gap-3 text-xs leading-5 text-zinc-600 sm:text-sm dark:text-zinc-400">
          {copy.facts.map((fact) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="size-4 shrink-0 text-blue-700 dark:text-blue-400" />
              {fact}
            </li>
          ))}
        </ul>
      </div>
      <ProductPreview locale={locale} />
    </div>
  </section>
  <div class="mx-auto max-w-7xl px-5 py-9 sm:px-8">
    <p class="mb-6 text-center font-mono text-[0.6rem] tracking-widest text-zinc-500 dark:text-zinc-400">
      {copy.stackLabel}
    </p>
    <ul class="grid grid-cols-3 gap-x-6 gap-y-5 text-center font-heading text-base font-semibold text-zinc-600 sm:grid-cols-6 sm:text-lg dark:text-zinc-300">
      {['Nx', 'Angular', 'Astro', 'Express', 'PostgreSQL', 'Tailwind'].map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  </div>
  <section
    id="foundation"
    class="border-y border-zinc-200 bg-zinc-50/70 py-16 sm:py-24 dark:border-zinc-800 dark:bg-zinc-900/30"
    aria-labelledby="foundation-title"
  >
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHeading
        kicker={copy.foundationKicker}
        title={copy.foundationTitle}
        description={copy.foundationIntro}
        id="foundation-title"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {copy.features.map((feature) => (
          <article class="flex flex-col rounded-2xl border border-zinc-200 bg-white p-6 sm:p-8 dark:border-zinc-800 dark:bg-zinc-950">
            <span class="mb-8 flex size-11 items-center justify-center rounded-xl border border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-900 dark:bg-blue-950/50 dark:text-blue-400">
              <Icon name={feature.icon} />
            </span>
            <h3 class="font-heading text-xl leading-7 font-semibold">{feature.title}</h3>
            <p class="mt-4 flex-1 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{feature.body}</p>
            <p class="mt-7 border-t border-zinc-200 pt-5 font-mono text-[0.65rem] leading-6 text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
              {feature.detail}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section
    class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-2 lg:gap-20"
    aria-labelledby="architecture-title"
  >
    <div>
      <SectionHeading
        kicker={copy.architectureKicker}
        title={copy.architectureTitle}
        description={copy.architectureBody}
        id="architecture-title"
      />
      <Link
        href={sitePath(locale, 'architecture')}
        underline="none"
        class="mt-7 inline-flex min-h-11 items-center gap-2 text-sm font-semibold"
      >
        {copy.architectureLink}
        <Icon name="arrow-right" class="size-4" />
      </Link>
    </div>
    <RuntimeMap locale={locale} />
  </section>
  <section
    class="border-y border-zinc-200 bg-zinc-50 py-16 sm:py-24 dark:border-zinc-800 dark:bg-zinc-900/30"
    aria-labelledby="design-title"
  >
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-[1fr_1.05fr] lg:gap-20">
      <div>
        <SectionHeading
          kicker={copy.designKicker}
          title={copy.designTitle}
          description={copy.designBody}
          id="design-title"
        />
        <p class="mt-7 flex items-baseline gap-3">
          <span class="font-heading text-5xl font-semibold tracking-tight text-blue-700 dark:text-blue-400">
            {count}
          </span>
          <span class="max-w-40 text-sm leading-6 text-zinc-500 dark:text-zinc-400">{copy.designCount}</span>
        </p>
        <Link
          href={sitePath(locale, 'ui')}
          underline="none"
          class="mt-7 inline-flex min-h-11 items-center gap-2 text-sm font-semibold"
        >
          {copy.designLink}
          <Icon name="arrow-right" class="size-4" />
        </Link>
      </div>
      <div class="min-w-0 overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-xl shadow-zinc-950/5 dark:border-zinc-700 dark:bg-zinc-950">
        <div class="border-b border-zinc-200 px-6 py-5 dark:border-zinc-800">
          <h3 class="font-heading text-lg font-semibold">{copy.sampleTitle}</h3>
          <p class="mt-2 text-sm leading-6 text-zinc-500 dark:text-zinc-400">{copy.sampleDescription}</p>
        </div>
        <div class="space-y-6 p-6 sm:p-8">
          <Field controlId="preview-workspace" label={copy.sampleLabel} description={copy.sampleHint}>
            <Input id="preview-workspace" value={copy.sampleValue} aria-describedby="preview-workspace-help" />
          </Field>
          <label class="flex min-h-11 items-center gap-3 text-sm leading-6">
            <Checkbox checked />
            {copy.sampleCheckbox}
          </label>
          <div class="flex flex-wrap gap-3">
            <LinkButton href={sitePath(locale, 'ui')} size="sm">
              {copy.sampleSave}
            </LinkButton>
            <LinkButton href={sitePath(locale, 'foundations')} size="sm" variant="secondary">
              {copy.sampleCancel}
            </LinkButton>
          </div>
        </div>
        <div class="overflow-x-auto border-t border-zinc-200 bg-zinc-50 px-6 py-5 font-mono text-[0.65rem] leading-6 text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
          <code>
            <span class="text-blue-700 dark:text-blue-400">button</span>.classes({'{'} variant: 'secondary', size: 'sm'{' '}
            {'}'})
          </code>
        </div>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="start-title">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading
          kicker={copy.startKicker}
          title={copy.startTitle}
          description={copy.startBody}
          id="start-title"
        />
        <Link
          href={sitePath(locale, 'docs')}
          underline="none"
          class="mt-7 inline-flex min-h-11 items-center gap-2 text-sm font-semibold"
        >
          {copy.startLink}
          <Icon name="arrow-right" class="size-4" />
        </Link>
      </div>
      <ol class="grid gap-8">
        {copy.startSteps.map(([title, body], i) => (
          <li class="flex gap-5">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full border border-zinc-300 font-mono text-xs text-blue-700 dark:border-zinc-700 dark:text-blue-400">
              0{i + 1}
            </span>
            <div>
              <h3 class="font-heading text-lg font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="mt-12">
      <Terminal
        title="visomi-stack / terminal"
        code={`pnpm install --frozen-lockfile
pnpm nx serve web-site`}
      />
    </div>
  </section>
  <section class="bg-blue-700 text-white dark:bg-blue-600" aria-labelledby="vision-title">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
      <div>
        <p class="mb-5 font-mono text-xs tracking-widest text-blue-100 dark:text-blue-50">{copy.visionKicker}</p>
        <h2
          id="vision-title"
          class="max-w-xl font-heading text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl"
        >
          {copy.visionTitle}
        </h2>
        <p class="mt-6 max-w-xl text-base leading-8 text-blue-50">{copy.visionBody}</p>
        <Link
          href={`${sitePath(locale, 'architecture')}#direction`}
          variant="inverse"
          class="mt-6 inline-flex min-h-11 items-center text-xs leading-6 decoration-white/50"
        >
          {copy.visionNote}
        </Link>
      </div>
      <ul class="grid content-center gap-6">
        {copy.visionItems.map(([title, body], i) => (
          <li class="flex gap-4 border-t border-white/25 pt-6">
            <span class="font-mono text-xs leading-7 text-blue-100 dark:text-blue-50">0{i + 1}</span>
            <div>
              <h3 class="font-heading text-xl font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-7 text-blue-100 dark:text-blue-50">{body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section
    class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20"
    aria-labelledby="faq-title"
  >
    <h2
      id="faq-title"
      class="max-w-md font-heading text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl"
    >
      {copy.faqTitle}
    </h2>
    <div class="grid gap-3">
      {copy.faq.map(([question, answer]) => (
        <Disclosure summary={question}>
          <p class="text-sm leading-7 text-zinc-600 dark:text-zinc-400">{answer}</p>
        </Disclosure>
      ))}
    </div>
  </section>
  <section class="border-t border-zinc-200 bg-zinc-50 px-5 py-16 text-center sm:px-8 sm:py-20 dark:border-zinc-800 dark:bg-zinc-900/30">
    <h2 class="font-heading text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{copy.finalTitle}</h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-zinc-600 dark:text-zinc-400">{copy.finalBody}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <LinkButton href={sitePath(locale, 'docs')}>
        {labels.start}
        <Icon name="arrow-right" class="size-4" />
      </LinkButton>
      <LinkButton href={sitePath(locale, 'ui')} variant="secondary">
        {labels.nav.ui}
      </LinkButton>
    </div>
  </section>
</SiteLayout>

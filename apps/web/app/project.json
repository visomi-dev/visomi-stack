{
  "name": "web-app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web/app/src",
  "tags": ["scope:web-frontend", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web/app",
        "browser": "apps/web/app/src/main.ts",
        "tsConfig": "apps/web/app/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/app/public"
          }
        ],
        "styles": ["apps/web/app/src/styles.css"],
        "server": "apps/web/app/src/main.server.ts",
        "ssr": {
          "entry": "apps/web/app/src/server.ts"
        },
        "outputMode": "server",
        "security": {
          "allowedHosts": ["localhost", "127.0.0.1", "stack.visomi.dev"]
        },
        "baseHref": "/app/",
        "polyfills": ["@angular/localize/init"]
      },
      "configurations": {
        "production": {
          "sourceMap": {
            "scripts": true,
            "styles": false,
            "hidden": true,
            "sourcesContent": true
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "localize": true,
          "i18nMissingTranslation": "error"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": ["en-US"],
          "baseHref": "/app/en/"
        },
        "development-es": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": ["es"],
          "baseHref": "/app/es/"
        }
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/styles.base.css",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/.postcssrc.json"
      ],
      "dependsOn": ["^build"]
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "web-app:build:production"
        },
        "development": {
          "buildTarget": "web-app:build:development"
        },
        "development-es": {
          "buildTarget": "web-app:build:development-es"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["standalone-build"],
      "options": {
        "command": "node dist/apps/web/app/server/standalone.mjs",
        "env": {
          "PORT": "4201",
          "HOST": "127.0.0.1"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "web-app:build",
        "format": "xlf",
        "outputPath": "apps/web/app/src/locales",
        "outFile": "messages.xlf"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -p apps/web/app/tsconfig.app.json --noEmit"
      }
    },
    "standalone-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/web/app/server/standalone.mjs",
        "{workspaceRoot}/dist/apps/web/app/server/standalone.mjs.map"
      ],
      "options": {
        "cwd": "apps/web/app",
        "command": "rolldown -c standalone.config.ts"
      }
    }
  },
  "i18n": {
    "sourceLocale": {
      "code": "en-US",
      "subPath": "en"
    },
    "locales": {
      "es": {
        "translation": "apps/web/app/src/locales/messages.es.xlf",
        "subPath": "es"
      }
    }
  }
}

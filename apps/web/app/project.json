{
  "name": "app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web/app/src",
  "i18n": {
    "sourceLocale": {
      "code": "en-US",
      "subPath": "en"
    },
    "locales": {
      "es": {
        "translation": "apps/web/app/src/locales/messages.es.xlf",
        "subPath": "es"
      }
    }
  },
  "targets": {
    "build": {
      "dependsOn": ["^build", "pwa-assets", "vault-worker-assets"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/build-pwa-assets.ts",
        { "dependentTasksOutputFiles": "**/vault-pin-worker.js" }
      ],
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "allowedCommonJsDependencies": ["debug", "xmlhttprequest-ssl"],
        "outputPath": "dist/apps/web/app",
        "browser": "apps/web/app/src/main.ts",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/web/app/tsconfig.app.json",
        "assets": [
          { "glob": "**/*", "input": "dist/pwa-assets" },
          { "glob": "*.js", "input": "dist/vault-worker-assets" },
          {
            "glob": "**/*",
            "input": "apps/web/app/public"
          }
        ],
        "styles": ["apps/web/app/src/styles.css"],
        "server": "apps/web/app/src/main.server.ts",
        "ssr": {
          "entry": "apps/web/app/src/server.ts"
        },
        "outputMode": "server",
        "security": {
          "allowedHosts": ["stack.visomi.dev", "localhost"]
        }
      },
      "configurations": {
        "production": {
          "serviceWorker": "apps/web/app/ngsw-config.json",
          "localize": true,
          "i18nMissingTranslation": "error",
          "baseHref": "/app/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "650kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "baseHref": "/app/",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "pwa-assets-typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsc --noEmit -p scripts/tsconfig-pwa.json" }
    },
    "vault-worker-assets": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/libs/frontend/shared/src/pin-worker.ts",
        "{workspaceRoot}/libs/frontend/shared/src/lib/vault/**",
        "{workspaceRoot}/libs/shared/crypto/src/**",
        "{workspaceRoot}/libs/shared/crypto/package.json",
        { "externalDependencies": ["esbuild", "hash-wasm", "zod"] }
      ],
      "outputs": ["{workspaceRoot}/dist/vault-worker-assets"],
      "options": {
        "command": "pnpm exec esbuild libs/frontend/shared/src/pin-worker.ts --bundle --platform=browser --format=esm --conditions=visomi-source --minify --outfile=dist/vault-worker-assets/vault-pin-worker.js"
      }
    },
    "pwa-assets": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/template.json",
        "{workspaceRoot}/scripts/build-pwa-assets.ts",
        "{workspaceRoot}/scripts/template/template-config.ts"
      ],
      "outputs": ["{workspaceRoot}/dist/pwa-assets"],
      "options": { "command": "node --experimental-strip-types scripts/build-pwa-assets.ts" }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "proxyConfig": "apps/web/app/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "app:build:production"
        },
        "development": {
          "buildTarget": "app:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "app:build",
        "format": "xlf",
        "outFile": "messages.xlf",
        "outputPath": "apps/web/app/src/locales"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "app:build",
        "port": 4200,
        "staticFilePath": "dist/apps/web/app/browser/en",
        "spa": true
      }
    }
  }
}

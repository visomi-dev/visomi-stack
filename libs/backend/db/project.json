{
  "name": "backend-db",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/db/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:util"],
  "// targets": "to see all targets run: nx show project backend-db --web",
  "targets": {
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/backend/db",
        "command": "drizzle-kit generate --config drizzle.config.ts"
      }
    },
    "db-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/backend/db",
        "command": "node tools/migrate.mjs"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/backend/db",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    },
    "test-ci": {
      "executor": "nx:noop",
      "dependsOn": ["test"]
    }
  }
}

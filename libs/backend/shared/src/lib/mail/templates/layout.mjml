<mjml>
  <mj-head>
    <mj-title>{{ title }}</mj-title>
    <mj-preview><!-- preview --></mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#18181b" font-size="16px" line-height="1.65" padding="0 24px 20px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1 {
        margin: 0;
        font-size: 26px;
        line-height: 1.3;
        font-weight: 700;
      }
      .verification-code div {
        overflow-wrap: anywhere;
        word-break: break-word;
      }
    </mj-style>
    <mj-style>
      @media (prefers-color-scheme: dark) {
        body,
        body > div {
          background-color: #09090b !important;
        }
        .mail-footer div {
          color: #a1a1aa !important;
        }
        .mail-card,
        .mail-card > table {
          background-color: #18181b !important;
        }
        .mail-copy div,
        .mail-copy h1 {
          color: #fafafa !important;
        }
        .mail-muted div {
          color: #a1a1aa !important;
        }
        .verification-code div {
          color: #1e40af !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f5" width="560px">
    <mj-wrapper padding="0 16px">
      <mj-section padding="28px 0 20px">
        <mj-column>
          <mj-image src="{{ logoUrl }}" alt="Visomi Stack" width="206px" height="52px" align="left" padding="0 8px" />
        </mj-column>
      </mj-section>
      <mj-section
        css-class="mail-card"
        background-color="#ffffff"
        border="1px solid #e4e4e7"
        border-radius="16px"
        padding="28px 0 8px"
      >
        <mj-column css-class="mail-copy">
          <mj-text
            ><h1>{{ title }}</h1></mj-text
          >
          <mj-text>{{ description }}</mj-text>
          <!-- content -->
        </mj-column>
      </mj-section>
      <mj-section padding="20px 0 28px">
        <mj-column>
          <mj-text css-class="mail-footer" color="#71717a" font-size="12px" padding="0 8px">Visomi Stack</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>

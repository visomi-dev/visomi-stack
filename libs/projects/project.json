{
  "name": "projects",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/projects/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "options": {
        "command": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/projects",
        "tsConfig": "libs/projects/tsconfig.lib.json",
        "packageJson": "libs/projects/package.json",
        "main": "libs/projects/src/index.ts",
        "assets": ["libs/projects/*.md"]
      }
    }
  }
}

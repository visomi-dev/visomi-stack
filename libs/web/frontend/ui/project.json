{
  "name": "web-frontend-ui",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/frontend/ui/src",
  "projectType": "library",
  "tags": ["scope:web-frontend", "type:ui"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -p libs/web/frontend/ui/tsconfig.lib.json --noEmit"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -p libs/web/frontend/ui/tsconfig.spec.json --noEmit"
      }
    }
  }
}

{
  "name": "dev-testing",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/development/testing/src",
  "projectType": "library",
  "tags": ["scope:development"],
  "// targets": "to see all targets run: nx show project dev-testing --web",
  "targets": {
    "eslint-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["lintPolicy"],
      "options": {
        "commands": ["eslint tools/lint-rules/*.mjs lint-staged.config.mjs", "node --test tools/lint-rules/*.spec.mjs"],
        "parallel": false
      }
    },
    "test": {
      "dependsOn": ["eslint-check"],
      "inputs": [
        "default",
        "^production",
        {
          "fileset": "{projectRoot}/tsconfig.spec.json",
          "dependencies": true
        },
        {
          "fileset": "{projectRoot}/tsconfig.storybook.json",
          "dependencies": true
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        },
        "lintPolicy"
      ]
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/development/testing",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    },
    "test-ci": {
      "executor": "nx:noop",
      "dependsOn": ["test"]
    }
  },
  "implicitDependencies": ["backend-shared"],
  "namedInputs": {
    "lintPolicy": [
      "sharedGlobals",
      "{workspaceRoot}/**/project.json",
      "{workspaceRoot}/tools/lint-rules/**/*",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/apps/web/{app,site}/eslint.config.mjs",
      "{workspaceRoot}/apps/web/app/src/app/shared/navigation.ts",
      "{workspaceRoot}/.prettierrc.json",
      "{workspaceRoot}/.vscode/settings.json",
      "{workspaceRoot}/lint-staged.config.mjs"
    ]
  }
}

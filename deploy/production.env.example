# Copy into the deployment secret store; never commit a populated version.
NODE_ENV=production
ENABLE_LOCAL_ACTIVATION=false
# Railway injects PORT at runtime. GATEWAY_PORT remains supported for local/compose runs.
GATEWAY_PORT=8080
SITE_URL=https://stack.visomi.dev
APP_BASE_URL=https://stack.visomi.dev/app
WEBAUTHN_ORIGIN=https://stack.visomi.dev
WEBAUTHN_RP_ID=stack.visomi.dev
GOOGLE_AUTH_CLIENT_ID=<google-web-client-id>
DATABASE_DRIVER=pg
DATABASE_AUTO_MIGRATE=false
DATABASE_URL=postgresql://<user>:<password>@postgres:5432/themis?sslmode=require
REDIS_URL=redis://:<password>@redis:6379
OPAQUE_SYNC_STORAGE=durable
OPAQUE_SYNC_S3_ENDPOINT=https://<s3-compatible-endpoint>
OPAQUE_SYNC_S3_BUCKET=themis-opaque-sync
OPAQUE_SYNC_S3_ACCESS_KEY=<opaque-storage-access-key>
OPAQUE_SYNC_S3_SECRET_KEY=<opaque-storage-secret-key>
LOCAL_AGENT_PUBLIC_KEY=<pinned-agent-public-key-pem>
SESSION_SECRET=<random-value-at-least-32-characters>
COOKIE_SECURE=true
# For Railway's single TLS-terminating ingress; use zero for direct traffic.
TRUST_PROXY_HOPS=1
AUTH_TOTP_ENCRYPTION_KEY=<dedicated-random-encryption-key-at-least-32-characters>
MAIL_TRANSPORT=mailgun
MAILGUN_API_KEY=<mail-provider-key>
MAILGUN_DOMAIN=<verified-domain>
MAILGUN_FROM=Themis <no-reply@example.invalid>
## Keep disabled until API/worker VAPID configuration and provider delivery are verified in this deployment.
WEB_PUSH_ENABLED=false
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
## Opt-in PRF vault unlock; unsupported authenticators fail without a weaker fallback.
VAULT_PRF_ENABLED=false
VAULT_BROWSER_ENABLED=false

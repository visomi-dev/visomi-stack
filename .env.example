# Generate a private secret before enabling authentication; never commit .env.
SESSION_SECRET=
# Local gateway defaults. Compose uses APP_DATABASE_URL for its container connection.
DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:5432/visomi
APP_PORT=8080
AUTH_ORIGIN=http://localhost:8080
AUTH_RP_ID=localhost
# For split deployment, share the auth database, session settings, and private Redis URL.
# Route /socket.io to the realtime process on the browser's existing origin.
# The embedded gateway uses in-memory events when this is empty.
REALTIME_REDIS_URL=

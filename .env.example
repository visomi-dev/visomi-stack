# Local development only. Prefer `pnpm template:init` to generate unique secrets.
# Never copy these local settings to a public environment.
NODE_ENV=development
HOST=127.0.0.1
GATEWAY_PORT=8080
PORT=8080
NG_ALLOWED_HOSTS=localhost
SITE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080/app
WEBAUTHN_ORIGIN=http://localhost:8080
WEBAUTHN_RP_ID=localhost
COOKIE_SECURE=false
SESSION_SECRET=replace-with-a-unique-local-secret

COMPOSE_PROJECT_NAME=visomi-local
POSTGRES_DB=visomi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_DRIVER=pg
DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:5432/visomi
DATABASE_AUTO_MIGRATE=false
DATABASE_SSL=false
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Memory mail does not send messages. --demo enables local fixture mailbox APIs.
MAIL_TRANSPORT=memory
ENABLE_TEST_API=false
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Visomi Stack <no-reply@localhost>
GOOGLE_AUTH_CLIENT_ID=
AUTH_TOTP_ENROLLMENT_ENABLED=true
AUTH_TOTP_ENCRYPTION_KEY=replace-with-a-dedicated-local-encryption-key

# Optional in development; mandatory production requirements are documented.
OPAQUE_SYNC_STORAGE=memory
# OPAQUE_SYNC_S3_ENDPOINT=https://your-object-store.example
OPAQUE_SYNC_S3_BUCKET=visomi-opaque-sync
OPAQUE_SYNC_S3_ACCESS_KEY=
OPAQUE_SYNC_S3_SECRET_KEY=
LOCAL_AGENT_PUBLIC_KEY=

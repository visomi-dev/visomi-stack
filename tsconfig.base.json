{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@visomi-stack/web-backend-shared": ["./libs/web/backend/shared/src/index.ts"],
      "@visomi-stack/backend-shared": ["./libs/backend/shared/src/index.ts"],
      "@visomi-stack/dev-testing": ["./libs/development/testing/src/index.ts"],
      "@visomi-stack/dev-testing/playwright": ["./libs/development/testing/src/playwright.ts"],
      "@visomi-stack/dev-testing/postgres": ["./libs/development/testing/src/postgres.ts"],
      "@visomi-stack/dev-testing/s3": ["./libs/development/testing/src/s3.ts"],
      "@visomi-stack/dev-testing/telemetry": ["./libs/development/testing/src/telemetry.ts"],
      "@visomi-stack/web-frontend-ui": ["./libs/web/frontend/ui/src/index.ts"],
      "@visomi-stack/web-shared-observability": ["./libs/web/shared/observability/src/index.ts"],
      "@visomi-stack/web-shared-observability/browser": ["./libs/web/shared/observability/src/lib/browser-loader.ts"],
      "@visomi-stack/web-shared-observability/consent-notice": [
        "./libs/web/shared/observability/src/lib/consent-notice.ts"
      ],
      "@visomi-stack/web-shared-observability/visits": ["./libs/web/shared/observability/src/lib/visit-browser.ts"],
      "@visomi-stack/web-frontend-db": ["./libs/web/frontend/db/src/index.ts"],
      "@visomi-stack/shared-db": ["./libs/shared/db/src/index.ts"],
      "@visomi-stack/web-frontend-db/storage": ["./libs/web/frontend/db/src/storage.ts"],
      "@visomi-stack/backend-db": ["./libs/backend/db/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
